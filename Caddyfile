# Servidor da frente em produção. Ele resolve o TLS e, quando a autorização por segmento
# está ligada, entrega os arquivos de vídeo depois de perguntar à aplicação se pode.

{$OPENTUBE_HOST:localhost} {
	encode zstd gzip

	# Autorização por segmento: a aplicação decide, o Caddy transporta. Assim a revogação
	# vale já no segmento seguinte, em vez de esperar uma assinatura vencer, e a aplicação
	# não gasta banda nem memória com bytes de vídeo.
	#
	# Os pedaços do vídeo chegam por um endereço opaco (/s/<selo>). A aplicação abre o selo e
	# responde, no X-Storage-Key, a chave do arquivo; só então o Caddy o busca. O route mantém
	# essa ordem, que o Caddy trocaria por conta própria. A chave vem só da aplicação: a que
	# o navegador mandasse é apagada antes.
	handle /s/* {
		route {
			request_header -X-Storage-Key
			forward_auth app:8080 {
				uri /_authz
				header_up X-Forwarded-Uri {http.request.orig_uri}
				copy_headers X-Storage-Key
			}
			# Sem chave da aplicação, nada vai ao storage.
			@semchave not header X-Storage-Key *
			respond @semchave 403
			rewrite * /vod/{http.request.header.X-Storage-Key}
			# Tipo genérico: no DevTools, o pedaço não se apresenta como vídeo.
			reverse_proxy minio:9000 {
				header_down Content-Type application/octet-stream
				header_down Cache-Control "private, max-age=3600"
			}
		}
	}

	# Legendas, miniaturas e a folha de prévias, pedidas pela página.
	handle_path /vod/* {
		forward_auth app:8080 {
			uri /_authz
			copy_headers Cookie
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}

		# O "?" no fim descarta qualquer parâmetro: o storage recebe só o caminho.
		rewrite * /vod{path}?
		# A URL não identifica quem pode ver. Sem isto, um cache compartilhado na frente
		# guardaria o arquivo de um visitante e o entregaria a outro.
		reverse_proxy minio:9000 {
			header_down Cache-Control "private, max-age=3600"
		}
	}

	# Envio direto do navegador. A autorização é a assinatura da URL; o Host tem de ser
	# o que foi assinado, senão o storage recusa o pedaço.
	handle /originals/* {
		reverse_proxy minio:9000 {
			header_up Host {http.request.host}
		}
	}

	handle {
		reverse_proxy app:8080
	}

	header {
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		# O conteúdo desta plataforma não deve aparecer em resultado de busca.
		X-Robots-Tag "noindex, nofollow"
	}
}
