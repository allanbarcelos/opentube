<Project>
  <PropertyGroup>
    <!-- O padrão do MSBuild é "obj\", no estilo Windows. O dotnet watch lê o caminho do
         manifesto de arquivos estáticos sem normalizar a barra e, no macOS e no Linux, procura
         um diretório chamado "obj\Debug" que não existe: perde o recarregamento de CSS e JS.
         Este arquivo é lido antes do padrão, então basta definir a pasta com barra normal. -->
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8618</WarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
