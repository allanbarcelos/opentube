# Banco de dados
OPENTUBE_DB=Host=localhost;Port=5432;Database=opentube;Username=opentube;Password=opentube

# Storage compatível com S3
OPENTUBE_S3__ENDPOINT=http://localhost:9000
OPENTUBE_S3__ACCESSKEY=opentube
OPENTUBE_S3__SECRETKEY=opentube123
OPENTUBE_S3__ORIGINALSBUCKET=originals
OPENTUBE_S3__VODBUCKET=vod

# Email
OPENTUBE_SMTP__HOST=localhost
OPENTUBE_SMTP__PORT=1025
OPENTUBE_SMTP__FROM=nao-responda@opentube.local

# Segredos
OPENTUBE_SECURITY__IPHASHPEPPER=troque-este-valor-em-producao

# ---------------------------------------------------------------------------
# Produção (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
OPENTUBE_HOST=videos.suaempresa.com
OPENTUBE_ADMIN_EMAIL=voce@suaempresa.com

OPENTUBE_DB_PASSWORD=
OPENTUBE_S3_SECRET=

# Trocar estes valores invalida todos os códigos e sessões em circulação.
OPENTUBE_TOKEN_PEPPER=
OPENTUBE_IP_PEPPER=

OPENTUBE_SMTP_HOST=
OPENTUBE_SMTP_PORT=587
OPENTUBE_SMTP_USER=
OPENTUBE_SMTP_PASSWORD=
OPENTUBE_SMTP_FROM=nao-responda@suaempresa.com

# Transcrição automática. Vazio desliga o recurso.
OPENTUBE_WHISPER_PATH=
OPENTUBE_WHISPER_MODEL=
