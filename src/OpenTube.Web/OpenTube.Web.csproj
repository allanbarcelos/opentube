<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpenTube.Infrastructure\OpenTube.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenTube.Domain\OpenTube.Domain.csproj" />
    <ProjectReference Include="..\OpenTube.Shared\OpenTube.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- A imagem restaura só o csproj, antes de copiar os .razor, e publica sem restaurar de novo.
         O SDK só baixa o pacote do blazor.web.js quando vê um .razor; sem este pedido o
         script fica de fora do manifesto e o navegador recebe 404. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

</Project>
