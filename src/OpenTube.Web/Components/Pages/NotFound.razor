@page "/not-found"

<PageTitle>@T["Not found — OpenTube"]</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-6">
            <h1 class="h4">@T["Video not found"]</h1>
            <p class="text-body-secondary mb-4">
                @T["The address does not exist, or the content is not available to you."]
            </p>

            <a class="btn btn-outline-secondary" href="/">@T["Back to the start"]</a>

            <AuthorizeView>
                <NotAuthorized>
                    <a class="btn btn-primary ms-2" href="/sign-in">@T["Sign in"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>
