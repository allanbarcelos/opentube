@page "/nao-encontrado"

<PageTitle>Não encontrado — OpenTube</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-6">
            <h1 class="h4">Vídeo não encontrado</h1>
            <p class="text-body-secondary mb-4">
                Ou o endereço não existe, ou o conteúdo não está liberado para o seu acesso.
            </p>

            <a class="btn btn-outline-secondary" href="/">Voltar ao início</a>

            <AuthorizeView>
                <NotAuthorized>
                    <a class="btn btn-primary ms-2" href="/entrar">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>
