@page "/sign-in"

<PageTitle>@T["Sign in — OpenTube"]</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">@T["Sign in"]</h1>
                    <p class="text-body-secondary small">
                        @T["We don't use a password. We email you a six-digit code."]
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Erro))
                    {
                        <div class="alert alert-danger" role="alert">@Erro</div>
                    }

                    @if (Enviado)
                    {
                        <div class="alert alert-success" role="status">
                            @T["If this address has access, the code is on its way."]
                        </div>

                        <form method="post" action="/sign-in/verify">
                            <AntiforgeryToken />
                            <input type="hidden" name="email" value="@Email" />
                            <input type="hidden" name="voltar" value="@Destino" />

                            <div class="mb-3">
                                <label class="form-label" for="codigo">@T["Code you received"]</label>
                                <input class="form-control codigo-acesso" id="codigo" name="codigo"
                                       inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                                       pattern="[0-9]{6}" required autofocus />
                            </div>

                            <button class="btn btn-primary w-100" type="submit">@T["Sign in"]</button>
                        </form>

                        <form method="post" action="/sign-in/code" class="mt-3 text-center">
                            <AntiforgeryToken />
                            <input type="hidden" name="email" value="@Email" />
                            <input type="hidden" name="voltar" value="@Destino" />
                            <button class="btn btn-link btn-sm" type="submit">@T["Send another code"]</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="/sign-in/code">
                            <AntiforgeryToken />
                            <input type="hidden" name="voltar" value="@Destino" />

                            <div class="mb-3">
                                <label class="form-label" for="email">@T["Your email"]</label>
                                <input class="form-control" id="email" name="email" type="email"
                                       value="@Email" autocomplete="email" required autofocus />
                            </div>

                            <button class="btn btn-primary w-100" type="submit">@T["Get a code"]</button>
                        </form>
                    }
                </div>
            </div>

            <p class="text-center text-body-secondary small mt-3 mb-0">
                @T["The link in the email also signs you in, without typing the code."]
            </p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "enviado")]
    private string? EnviadoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Enviado => EnviadoBruto == "1" && !string.IsNullOrWhiteSpace(Email);

    /// <summary>Para onde ir depois de entrar: o do convite ou, sem ele, o que o login interrompeu.</summary>
    [SupplyParameterFromQuery(Name = "voltar")]
    private string? Voltar { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    private string? Destino => Voltar ?? ReturnUrl;
}
