@page "/collections/{slug}"
@using OpenTube.Infrastructure.Playback
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores
@inject NavigationManager Navegacao

<TituloDaPagina Pagina="@(Lista?.Name ?? T["Collection"])" />

<div class="container py-4">
    @if (Lista is not null)
    {
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h4 mb-0">@Lista.Name</h1>
            @if (Lista.Videos.Any(v => v.IsNew))
            {
                <span class="badge text-bg-primary video-new">@T["New"]</span>
            }
            @if (Espectador.IsAuthenticated)
            {
                <EstrelaDaColecao Slug="@Lista.Slug" Favorita="Lista.IsFavorite" Destino="@($"/collections/{Lista.Slug}")" />
            }
        </div>
        <p class="text-body-secondary mb-3">
            @T.Format(Lista.Videos.Count == 1 ? "{0} video" : "{0} videos", Lista.Videos.Count)
        </p>

        @if (!string.IsNullOrWhiteSpace(Lista.Description))
        {
            <p class="mb-4" style="white-space: pre-wrap">@Lista.Description</p>
        }

        <div class="card">
            <ListaDaPlaylist Videos="Lista.Videos" CollectionSlug="@Lista.Slug" Classe="list-group-flush" />
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Viewer Espectador = Viewer.Anonymous;

    private PlaylistListing? Lista;

    protected override async Task OnInitializedAsync()
    {
        Espectador = await Espectadores.GetAsync(Http.RequestAborted);
        Lista = await Catalogo.PlaylistAsync(Espectador, Slug, Http.RequestAborted);

        // Sem nenhum vídeo visível a coleção responde como inexistente: o nome também não vaza.
        if (Lista is null)
            Navegacao.NotFound();
    }
}
