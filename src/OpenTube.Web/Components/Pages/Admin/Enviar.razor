@page "/admin/enviar"
@using Microsoft.AspNetCore.Antiforgery
@attribute [Authorize(Policy = Policies.Administrator)]
@inject IAntiforgery Antifalsificacao

<PageTitle>Enviar vídeo — OpenTube</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="h4 mb-3">Enviar vídeo</h1>

            <div class="card">
                <div class="card-body">
                    <form id="formulario-envio" data-token="@Token">
                        <div class="mb-3">
                            <label class="form-label" for="titulo">Título</label>
                            <input class="form-control" id="titulo" maxlength="300" required autofocus />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="descricao">Descrição</label>
                            <textarea class="form-control" id="descricao" rows="3" maxlength="10000"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="arquivo">Arquivo de vídeo</label>
                            <input class="form-control" id="arquivo" type="file" accept="video/*" required />
                            <div class="form-text">
                                O arquivo vai direto do seu navegador para o storage, sem passar pelo servidor.
                            </div>
                        </div>

                        <div class="progress d-none mb-2" role="progressbar" aria-label="Progresso do envio"
                             aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" id="barra-progresso" style="width: 0%"></div>
                        </div>

                        <p class="small text-body-secondary" id="situacao-envio"></p>

                        <div class="alert alert-danger d-none" id="erro-envio" role="alert"></div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" id="botao-enviar" type="submit">Enviar</button>
                            <a class="btn btn-outline-secondary" href="/admin">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-light border mt-3 small mb-0">
                Todo vídeo enviado nasce <strong>privado</strong>. A liberação é feita depois, na
                página do vídeo.
            </div>
        </div>
    </div>
</div>

<script src="js/upload.js"></script>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    private string Token = string.Empty;

    protected override void OnInitialized()
    {
        // O envio é feito por JavaScript, então o formulário carrega a credencial no próprio
        // elemento e o script a devolve no cabeçalho de cada chamada.
        Token = Antifalsificacao.GetAndStoreTokens(Http).RequestToken ?? string.Empty;
    }
}
