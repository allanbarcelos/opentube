@page "/admin/upload"
@using Microsoft.AspNetCore.Antiforgery
@using OpenTube.Domain.Media
@attribute [Authorize(Policy = Policies.Administrator)]
@inject IAntiforgery Antifalsificacao

<PageTitle>@T["Upload videos — OpenTube"]</PageTitle>

@* O envio é todo feito pelo upload.js, carregado para todas as páginas no App.razor: um script
   colocado aqui não rodaria quando se chega pela navegação aprimorada. *@
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <h1 class="h4 mb-3">@T["Upload videos"]</h1>

            <form id="formulario-envio" novalidate
                  data-token="@Token"
                  data-max-titulo="@UploadNames.MaxTitleLength"
                  data-max-colecao="@UploadNames.MaxCollectionNameLength"
                  data-preparando="@T["Preparing…"]"
                  data-enviando="@T["Uploading… {0}%"]"
                  data-finalizando="@T["Finishing…"]"
                  data-aguardando="@T["Waiting"]"
                  data-concluido="@T["Sent"]"
                  data-falhou="@T["Failed"]"
                  data-abrir="@T["Open"]"
                  data-remover="@T["Remove from the list"]"
                  data-resumo-fila="@T["{0} video(s) · {1}"]"
                  data-progresso-geral="@T["{0} of {1} sent"]"
                  data-conclusao="@T["{0} of {1} video(s) sent."]"
                  data-com-falhas="@T["{0} failed. Press Send again to retry only those."]"
                  data-abrir-colecao="@T["Open the collection"]"
                  data-ver-videos="@T["Go to the videos"]"
                  data-ignorados="@T["{0} file(s) skipped, not videos: {1}"]"
                  data-sem-arquivos="@T["Choose at least one video."]"
                  data-pasta-vazia="@T["The folder has no videos."]"
                  data-sem-colecao="@T["Enter a name for the collection."]"
                  data-sair="@T["Uploads in progress will be lost."]"
                  data-falha-servidor="@T["Could not reach the server."]"
                  data-falha-pedaco="@T["A part of the file failed to upload."]"
                  data-falha-storage="@T["Storage did not confirm the part."]"
                  data-falha-leitura="@T["Could not read the dropped files."]">

                @* Uma área só: clicar escolhe vídeos, o link escolhe uma pasta, e arrastar aceita os
                   dois. Os campos de arquivo ficam escondidos: o navegador não tem uma janela que
                   escolha arquivos e pastas ao mesmo tempo, então cada um abre a sua. *@
                <div class="area-de-envio card mb-3" id="area-de-envio" data-soltar tabindex="0" role="button"
                     aria-describedby="ajuda-envio" aria-label="@T["Choose videos to upload"]">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-cloud-arrow-up display-5 text-primary" aria-hidden="true"></i>
                        <p class="fs-5 mt-2 mb-1 area-de-envio-normal">@T["Drag videos or a folder here"]</p>
                        <p class="fs-5 mt-2 mb-1 area-de-envio-soltando">@T["Drop to add to the list"]</p>
                        <p class="text-body-secondary mb-3">
                            @T["or"]
                            <button class="btn btn-link p-0 align-baseline" type="button" data-escolher="arquivos">@T["choose videos"]</button>
                            ·
                            <button class="btn btn-link p-0 align-baseline" type="button" data-escolher="pasta">@T["choose a folder"]</button>
                        </p>
                        <p class="small text-body-secondary mb-0 mx-auto" id="ajuda-envio" style="max-width: 36rem">
                            @T["Videos add to the list, as many times as you like; the title of each one is its file name, and can be changed below. A folder becomes a collection with its name, and its videos (subfolders included) go into it."]
                        </p>
                    </div>
                </div>
                @* Fora da área: o clique que o script dá neles não pode voltar para ela. *@
                <input class="d-none" id="arquivos" type="file" accept="video/*" multiple tabindex="-1" aria-hidden="true" />
                <input class="d-none" id="pasta" type="file" webkitdirectory multiple tabindex="-1" aria-hidden="true" />

                <div class="card mb-3 d-none" id="bloco-colecao">
                    <div class="card-body">
                        <label class="form-label" for="nome-colecao">@T["Collection"]</label>
                        <input class="form-control" id="nome-colecao" maxlength="@UploadNames.MaxCollectionNameLength" />
                        <div class="form-text">@T["A new collection is created with this name when the upload starts."]</div>
                    </div>
                </div>

                <div class="card mb-3 d-none" id="bloco-fila">
                    <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                        <span id="resumo-fila"></span>
                        <span class="small text-body-secondary" id="progresso-geral"></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr class="small text-body-secondary">
                                    <th scope="col" class="text-end">#</th>
                                    <th scope="col">@T["Title"]</th>
                                    <th scope="col">@T["Size"]</th>
                                    <th scope="col">@T["Status"]</th>
                                    <th scope="col"><span class="visually-hidden">@T["Actions"]</span></th>
                                </tr>
                            </thead>
                            <tbody id="fila-envio"></tbody>
                        </table>
                    </div>
                </div>

                <p class="small text-body-secondary d-none" id="arquivos-ignorados"></p>

                <div class="alert alert-danger d-none" id="erro-envio" role="alert"></div>
                <div class="alert alert-success d-none" id="conclusao-envio" role="status"></div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" id="botao-enviar" type="submit">@T["Send"]</button>
                    <a class="btn btn-outline-secondary" href="/admin">@T["Cancel"]</a>
                </div>
            </form>

            <template id="modelo-linha-envio">
                <tr>
                    <td class="small text-body-secondary text-end" data-campo="numero"></td>
                    <td class="w-50">
                        <input class="form-control form-control-sm" data-campo="titulo" maxlength="@UploadNames.MaxTitleLength" aria-label="@T["Title"]" />
                        <div class="small text-body-secondary text-truncate mt-1" data-campo="caminho"></div>
                    </td>
                    <td class="small text-nowrap" data-campo="tamanho"></td>
                    <td class="small" style="min-width: 10rem" data-campo="situacao"></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-campo="remover"
                                title="@T["Remove"]" aria-label="@T["Remove"]"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                    </td>
                </tr>
            </template>

            <div class="alert alert-light border mt-3 small mb-0">
                @T["Every uploaded video starts private. Files go straight from your browser to storage, one at a time. Access is granted later, on the video or collection page."]
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    private string Token = string.Empty;

    protected override void OnInitialized()
    {
        // O envio é feito por JavaScript, então o formulário carrega a credencial no próprio
        // elemento e o script a devolve no cabeçalho de cada chamada.
        Token = Antifalsificacao.GetAndStoreTokens(Http).RequestToken ?? string.Empty;
    }
}
