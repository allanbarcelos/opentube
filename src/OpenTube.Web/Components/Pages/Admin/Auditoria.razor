@page "/admin/audit"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Security
@attribute [Authorize(Policy = Policies.Administrator)]
@inject AuditTrail Trilha

<PageTitle>@T["Audit — Administration"]</PageTitle>

<div class="container py-4">
    <nav aria-label="@T["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@T["Audit"]</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@T["Administrative actions"]</span>

            <form action="/admin/audit" method="get" class="d-flex gap-2" role="search">
                <select class="form-select form-select-sm" name="type" aria-label="@T["Filter by type"]">
                    <option value="">@T["Everything"]</option>
                    <option value="video" selected="@(Tipo == "video")">@T["Videos"]</option>
                    <option value="collection" selected="@(Tipo == "collection")">@T["Collections"]</option>
                    <option value="grant" selected="@(Tipo == "grant")">@T["Access grants"]</option>
                    <option value="domain" selected="@(Tipo == "domain")">@T["Domains"]</option>
                </select>
                <input class="form-control form-control-sm" type="search" name="who" value="@Quem"
                       placeholder="@T["Who did it"]" aria-label="@T["Filter by who did it"]" />
                <button class="btn btn-sm btn-outline-secondary" type="submit">@T["Filter"]</button>
            </form>
        </div>

        @if (Registros.Count == 0)
        {
            <div class="card-body text-center text-body-secondary py-5">
                @T["No actions recorded"]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["When"]</th>
                            <th scope="col">@T["Who"]</th>
                            <th scope="col">@T["What"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registro in Registros)
                        {
                            <tr>
                                <td class="small text-nowrap">
                                    @registro.At.ToLocalTime().ToString("g")
                                </td>
                                <td class="small">@registro.ActorEmail</td>
                                <td>
                                    @registro.Summary
                                    <span class="d-block small text-body-secondary font-monospace">@registro.Action</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <p class="small text-body-secondary mt-3 mb-0">
        @T["The log stores the origin as a digest, never in clear text."]
    </p>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "type")]
    private string? Tipo { get; set; }

    [SupplyParameterFromQuery(Name = "who")]
    private string? Quem { get; set; }

    private IReadOnlyList<AuditEntry> Registros = [];

    protected override async Task OnInitializedAsync() =>
        Registros = await Trilha.ListAsync(TipoDaEntidade(Tipo), actorEmail: Quem, cancellationToken: Http.RequestAborted);

    /// <summary>O endereço usa inglês; o registro guarda o código estável da entidade.</summary>
    private static string? TipoDaEntidade(string? tipo) => tipo switch
    {
        "collection" => AuditEntities.Colecao,
        "grant" => AuditEntities.Concessao,
        "domain" => AuditEntities.Dominio,
        "person" => AuditEntities.Pessoa,
        null or "" => null,
        _ => tipo
    };
}
