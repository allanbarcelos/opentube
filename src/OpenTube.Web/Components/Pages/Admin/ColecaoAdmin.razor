@page "/admin/colecoes/{collectionId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Playback
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject CollectionService Colecoes
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores
@inject ShareLinkFlash Links
@inject NavigationManager Navegacao

<PageTitle>@(Colecao?.Name ?? "Coleção") — Administração</PageTitle>

<div class="container py-4">
    @if (Colecao is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="Trilha de navegação">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Administração</a></li>
                <li class="breadcrumb-item"><a href="/admin/colecoes">Coleções</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Colecao.Name</li>
            </ol>
        </nav>

        @foreach (var aviso in Avisos)
        {
            <div class="alert alert-success" role="status">@aviso</div>
        }
        @if (!string.IsNullOrWhiteSpace(LinkCriado))
        {
            <div class="alert alert-warning">
                <p class="mb-2"><strong>Link criado.</strong> Copie agora: ele não será exibido de novo.</p>
                <input class="form-control font-monospace" value="@LinkCriado" readonly
                       onclick="this.select()" aria-label="Endereço do link de compartilhamento" />
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="alert alert-danger" role="alert">@Erro</div>
        }
        @if (Colecao.IsDeleted)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Esta coleção está excluída; as concessões sobre ela não alcançam mais nada.</span>
                <form method="post" action="/admin/colecoes/@Colecao.Id/restaurar">
                    <AntiforgeryToken />
                    <button class="btn btn-sm btn-outline-dark" type="submit">Restaurar</button>
                </form>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Vídeos da coleção</span>
                        <span class="badge text-bg-secondary">@Videos.Count</span>
                    </div>

                    @if (Videos.Count == 0)
                    {
                        <div class="card-body text-center text-body-secondary py-4">
                            Nenhum vídeo nesta coleção ainda.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var video in Videos)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                                    <div>
                                        <a href="/admin/videos/@video.Id" class="text-decoration-none">@video.Title</a>
                                        <span class="d-block small text-body-secondary">@video.DurationLabel</span>
                                    </div>
                                    <form method="post" action="/admin/colecoes/@Colecao.Id/videos/remover">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="videoId" value="@video.Id" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Remover</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }

                    <div class="card-body border-top">
                        <form method="post" action="/admin/colecoes/@Colecao.Id/videos/adicionar" class="row g-2">
                            <AntiforgeryToken />

                            <div class="col-sm-8">
                                <label class="form-label visually-hidden" for="videoId">Vídeo</label>
                                <select class="form-select" id="videoId" name="videoId" required>
                                    <option value="">Escolha um vídeo…</option>
                                    @foreach (var video in Disponiveis)
                                    {
                                        <option value="@video.Id">@video.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="col-sm-4">
                                <button class="btn btn-outline-primary w-100" type="submit">Acrescentar</button>
                            </div>
                        </form>
                    </div>
                </div>

                <PainelDeAcessos TargetType="GrantTargetType.Collection" TargetId="Colecao.Id" />
            </div>

            <div class="col-lg-5">
                <div class="card mb-3">
                    <div class="card-header">Dados da coleção</div>
                    <div class="card-body">
                        <form method="post" action="/admin/colecoes/@Colecao.Id/salvar">
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label" for="nome">Nome</label>
                                <input class="form-control" id="nome" name="nome" value="@Colecao.Name"
                                       maxlength="200" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="descricao">Descrição</label>
                                <textarea class="form-control" id="descricao" name="descricao" rows="3"
                                          maxlength="2000">@Colecao.Description</textarea>
                            </div>

                            <button class="btn btn-primary" type="submit">Salvar</button>
                        </form>
                    </div>
                </div>

                @if (!Colecao.IsDeleted)
                {
                    <div class="card border-danger">
                        <div class="card-header text-danger">Excluir</div>
                        <div class="card-body">
                            <p class="small text-body-secondary">
                                Os vídeos continuam no acervo; apenas o agrupamento deixa de existir, e com ele
                                o acesso concedido através dele.
                            </p>
                            <form method="post" action="/admin/colecoes/@Colecao.Id/excluir">
                                <AntiforgeryToken />
                                <button class="btn btn-outline-danger w-100" type="submit">Excluir coleção</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid CollectionId { get; set; }

    [SupplyParameterFromQuery(Name = "criada")]
    private string? Criada { get; set; }

    [SupplyParameterFromQuery(Name = "salva")]
    private string? Salva { get; set; }

    [SupplyParameterFromQuery(Name = "adicionado")]
    private string? Adicionado { get; set; }

    [SupplyParameterFromQuery(Name = "removido")]
    private string? Removido { get; set; }

    [SupplyParameterFromQuery(Name = "restaurada")]
    private string? Restaurada { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    [SupplyParameterFromQuery(Name = "convidados")]
    private int? Convidados { get; set; }

    [SupplyParameterFromQuery(Name = "dominio")]
    private string? DominioBruto { get; set; }

    [SupplyParameterFromQuery(Name = "revogado")]
    private string? RevogadoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    private string? LinkBruto { get; set; }

    private string? LinkCriado;

    private Collection? Colecao;

    private IReadOnlyList<VideoSummary> Videos = [];

    private IReadOnlyList<VideoSummary> Disponiveis = [];

    private IEnumerable<string> Avisos
    {
        get
        {
            if (Criada == "1") yield return "Coleção criada.";
            if (Salva == "1") yield return "Alterações salvas.";
            if (Adicionado == "1") yield return "Vídeo acrescentado à coleção.";
            if (Removido == "1") yield return "Vídeo removido da coleção.";
            if (Restaurada == "1") yield return "Coleção restaurada.";
            if (Convidados is > 0) yield return $"{Convidados} convite(s) enviado(s).";
            if (DominioBruto == "1") yield return "Domínio liberado.";
            if (RevogadoBruto == "1") yield return "Acesso revogado.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LinkCriado = Links.Take(LinkBruto);

        Colecao = await Colecoes.FindAsync(CollectionId, Http.RequestAborted);

        if (Colecao is null)
        {
            Navegacao.NotFound();
            return;
        }

        Videos = await Colecoes.VideosOfAsync(CollectionId, Http.RequestAborted);

        var jaNaColecao = Videos.Select(v => v.Id).ToHashSet();
        var espectador = await Espectadores.GetAsync(Http.RequestAborted);

        var acervo = await Catalogo.BrowseAsync(espectador, page: 1, pageSize: 100, cancellationToken: Http.RequestAborted);

        Disponiveis = acervo.Items.Where(v => !jaNaColecao.Contains(v.Id)).ToList();
    }
}
