@page "/admin/collections/{collectionId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Playback
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject CollectionService Colecoes
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores
@inject NavigationManager Navegacao

<PageTitle>@(Colecao?.Name ?? T["Collection"]) — @T["Administration"]</PageTitle>

<div class="container py-4">
    @if (Colecao is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="@T["Breadcrumb"]">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
                <li class="breadcrumb-item"><a href="/admin/collections">@T["Collections"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Colecao.Name</li>
            </ol>
        </nav>

        @foreach (var aviso in Avisos)
        {
            <div class="alert alert-success" role="status">@aviso</div>
        }
        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="alert alert-danger" role="alert">@Erro</div>
        }
        @if (VideosPrivados > 0)
        {
            <div class="alert alert-warning" role="status">
                @(VideosPrivados == 1
                    ? T.Format("{0} video in this collection is private. To make it accessible, set it to Restricted or Public.", VideosPrivados)
                    : T.Format("{0} videos in this collection are private. To make them accessible, set each one to Restricted or Public.", VideosPrivados))
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@T["Videos in the collection"]</span>
                        <span class="badge text-bg-secondary">@Videos.Count</span>
                    </div>

                    @if (Videos.Count == 0)
                    {
                        <div class="card-body text-center text-body-secondary py-4">
                            @T["No videos in this collection yet."]
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var video in Videos)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                                    <div>
                                        <a href="/admin/videos/@video.Id" class="text-decoration-none">@video.Title</a>
                                        @if (video.Visibility == (int)VideoVisibility.Private)
                                        {
                                            <span class="badge text-bg-secondary ms-2">@T["Private"]</span>
                                        }
                                        <span class="d-block small text-body-secondary">@video.DurationLabel</span>
                                    </div>
                                    <form method="post" action="/admin/collections/@Colecao.Id/videos/remove">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="videoId" value="@video.Id" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@T["Remove"]</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }

                    <div class="card-body border-top">
                        @if (Conflito is not null)
                        {
                            <div class="alert alert-warning" role="alert">
                                <p class="mb-2">
                                    @T.Format(
                                        "{0} belongs to {1}. If you continue, it will be moved to this collection.",
                                        Conflito.Title,
                                        Conflito.CollectionNames)
                                </p>
                                <form method="post" action="/admin/collections/@Colecao.Id/videos/add" class="d-flex flex-wrap gap-2">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="videoId" value="@Conflito.VideoId" />
                                    <input type="hidden" name="confirmar" value="true" />
                                    <button class="btn btn-warning" type="submit">@T["Move"]</button>
                                    <a class="btn btn-outline-secondary" href="/admin/collections/@Colecao.Id">@T["Cancel"]</a>
                                </form>
                            </div>
                        }

                        <form method="post" action="/admin/collections/@Colecao.Id/videos/add" class="row g-2">
                            <AntiforgeryToken />

                            <div class="col-sm-8">
                                <label class="form-label visually-hidden" for="videoId">@T["Video"]</label>
                                <select class="form-select" id="videoId" name="videoId" required>
                                    <option value="">@T["Choose a video…"]</option>
                                    @foreach (var video in Disponiveis)
                                    {
                                        <option value="@video.Id">@video.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="col-sm-4">
                                <button class="btn btn-outline-primary w-100" type="submit">@T["Add"]</button>
                            </div>
                        </form>
                    </div>
                </div>

                <PainelDeConvites TargetType="GrantTargetType.Collection" TargetId="Colecao.Id" />
            </div>

            <div class="col-lg-5">
                <div class="card mb-3">
                    <div class="card-header">@T["Collection details"]</div>
                    <div class="card-body">
                        <form method="post" action="/admin/collections/@Colecao.Id/save">
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label" for="nome">@T["Name"]</label>
                                <input class="form-control" id="nome" name="nome" value="@Colecao.Name"
                                       maxlength="200" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="descricao">@T["Description"]</label>
                                <textarea class="form-control" id="descricao" name="descricao" rows="3"
                                          maxlength="2000">@Colecao.Description</textarea>
                            </div>

                            <button class="btn btn-primary" type="submit">@T["Save"]</button>
                        </form>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">@T["Thumbnail"]</div>
                    <div class="card-body">
                        @if (Colecao.HasThumbnail)
                        {
                            <img class="card-img-top video-thumb rounded mb-3"
                                 src="/api/collections/@Colecao.Id/thumbnail?v=@Colecao.ThumbnailVersion"
                                 alt="@T.Format("Thumbnail of {0}", Colecao.Name)" />
                        }
                        else
                        {
                            <div class="card-img-top video-thumb collection-cover rounded mb-3" aria-hidden="true">
                                <span>@Colecao.Name</span>
                            </div>
                            <p class="small text-body-secondary">@T["The card shows the collection name until an image is set."]</p>
                        }

                        <form method="post" action="/admin/collections/@Colecao.Id/thumbnail" enctype="multipart/form-data">
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label" for="arquivo">@T["Thumbnail image"]</label>
                                <input class="form-control" type="file" id="arquivo" name="arquivo"
                                       accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" required />
                                <div class="form-text">
                                    @T["JPEG, PNG or WebP, up to 5 MB. Larger images are reduced to fit within 1280 × 720 pixels; smaller ones stay as they are. The longest side needs at least 160 pixels."]
                                </div>
                            </div>

                            <button class="btn btn-primary w-100" type="submit">
                                @(Colecao.HasThumbnail ? T["Change the thumbnail"] : T["Set the thumbnail"])
                            </button>
                        </form>

                        @if (Colecao.HasThumbnail)
                        {
                            <form method="post" action="/admin/collections/@Colecao.Id/thumbnail/remove" class="mt-3">
                                <AntiforgeryToken />
                                <button class="btn btn-outline-danger w-100" type="submit">@T["Remove the thumbnail"]</button>
                            </form>
                        }
                    </div>
                </div>

                <div class="card border-danger">
                    <div class="card-header text-danger">@T["Delete"]</div>
                    <div class="card-body">
                        <form method="post" action="/admin/collections/@Colecao.Id/delete">
                            <AntiforgeryToken />

                            <p class="small text-body-secondary">
                                @T["This collection will be permanently deleted, along with every access grant on it. It cannot be restored."]
                            </p>

                            @if (Videos.Count == 0)
                            {
                                <input type="hidden" name="videos" value="desvincular" />
                            }
                            else
                            {
                                <fieldset class="mb-3">
                                    <legend class="form-label">@T["What happens to the videos?"]</legend>

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="videos" id="videos-desvincular"
                                               value="desvincular" checked required />
                                        <label class="form-check-label" for="videos-desvincular">
                                            @T["Unlink them. They stay in the library."]
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="videos" id="videos-mover"
                                               value="mover" required disabled="@(OutrasColecoes.Count == 0)" />
                                        <label class="form-check-label" for="videos-mover">
                                            @T["Move them to another collection."]
                                        </label>
                                    </div>

                                    @if (OutrasColecoes.Count == 0)
                                    {
                                        <p class="form-text">@T["There is no other collection to move them to."]</p>
                                    }
                                    else
                                    {
                                        <select class="form-select form-select-sm my-2" id="destino" name="destino"
                                                aria-label="@T["Choose a collection…"]">
                                            <option value="">@T["Choose a collection…"]</option>
                                            @foreach (var outra in OutrasColecoes)
                                            {
                                                <option value="@outra.Id">@outra.Name</option>
                                            }
                                        </select>
                                    }

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="videos" id="videos-excluir"
                                               value="excluir" required />
                                        <label class="form-check-label" for="videos-excluir">
                                            @T["Delete them too. They are permanently deleted, the same way as deleting a video."]
                                        </label>
                                    </div>
                                </fieldset>
                            }

                            <ConfirmacaoDeExclusao Id="confirmar-exclusao-colecao" Rotulo="@T["Delete collection"]">
                                @if (Videos.Count == 0)
                                {
                                    <p class="mb-0" data-confirmacao-texto>
                                        @T["This collection will be permanently deleted, along with every access grant on it. It cannot be restored."]
                                    </p>
                                }
                                else
                                {
                                    <p class="mb-0" data-confirmacao-texto>
                                        @T["The collection will be permanently deleted and its videos will be unlinked. It cannot be restored."]
                                    </p>
                                    <p hidden data-confirmacao="desvincular">@T["The collection will be permanently deleted and its videos will be unlinked. It cannot be restored."]</p>
                                    <p hidden data-confirmacao="excluir">@T["The collection will be permanently deleted and its videos will be deleted. It cannot be restored."]</p>
                                    <p hidden data-confirmacao="mover">@T["The collection will be permanently deleted and its videos will be moved to '{0}'. It cannot be restored."]</p>
                                    <p hidden data-confirmacao="mover-vazio">@T["Choose another collection."]</p>
                                }
                            </ConfirmacaoDeExclusao>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid CollectionId { get; set; }

    [SupplyParameterFromQuery(Name = "criada")]
    private string? Criada { get; set; }

    [SupplyParameterFromQuery(Name = "salva")]
    private string? Salva { get; set; }

    [SupplyParameterFromQuery(Name = "adicionado")]
    private string? Adicionado { get; set; }

    [SupplyParameterFromQuery(Name = "movido")]
    private string? Movido { get; set; }

    [SupplyParameterFromQuery(Name = "mover")]
    private string? Mover { get; set; }

    [SupplyParameterFromQuery(Name = "removido")]
    private string? Removido { get; set; }

    [SupplyParameterFromQuery(Name = "capa")]
    private string? Capa { get; set; }

    [SupplyParameterFromQuery(Name = "semcapa")]
    private string? SemCapa { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private Collection? Colecao;

    private IReadOnlyList<VideoSummary> Videos = [];

    private IReadOnlyList<VideoSummary> Disponiveis = [];

    private IReadOnlyList<CollectionSummary> OutrasColecoes = [];

    private ConflitoDeVideo? Conflito;

    private int VideosPrivados => Videos.Count(v => v.Visibility == (int)VideoVisibility.Private);

    private IEnumerable<string> Avisos
    {
        get
        {
            if (Criada == "1") yield return T["Collection created."];
            if (Salva == "1") yield return T["Changes saved."];
            if (Adicionado == "1") yield return T["Video added to the collection."];
            if (Movido == "1") yield return T["Video moved to this collection."];
            if (Removido == "1") yield return T["Video removed from the collection."];
            if (Capa == "1") yield return T["Thumbnail saved."];
            if (SemCapa == "1") yield return T["Thumbnail removed. The card shows the collection name again."];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Colecao só é preenchido no fim. O Blazor desenha a página na primeira espera que não termina
        // na hora; se Colecao já estivesse preenchido, os painéis filhos começariam a consultar o banco
        // pelo mesmo contexto enquanto esta página ainda consulta, e o EF recusa duas operações
        // simultâneas (erro 500 intermitente).
        var colecao = await Colecoes.FindAsync(CollectionId, Http.RequestAborted);

        if (colecao is null)
        {
            Navegacao.NotFound();
            return;
        }

        Videos = await Colecoes.VideosOfAsync(CollectionId, Http.RequestAborted);
        OutrasColecoes = (await Colecoes.ListAsync(cancellationToken: Http.RequestAborted))
            .Where(c => c.Id != CollectionId)
            .ToList();

        var jaNaColecao = Videos.Select(v => v.Id).ToHashSet();
        var espectador = await Espectadores.GetAsync(Http.RequestAborted);

        var acervo = await Catalogo.BrowseAsync(espectador, page: 1, pageSize: 100, cancellationToken: Http.RequestAborted);

        Disponiveis = acervo.Items.Where(v => !jaNaColecao.Contains(v.Id)).ToList();

        if (Guid.TryParse(Mover, out var videoEmOutra))
            Conflito = await Colecoes.FindPlacementConflictAsync(CollectionId, videoEmOutra, Http.RequestAborted);

        Colecao = colecao;
    }
}
