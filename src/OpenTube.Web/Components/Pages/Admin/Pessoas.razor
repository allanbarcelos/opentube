@page "/admin/people"
@using OpenTube.Infrastructure.Analytics
@attribute [Authorize(Policy = Policies.Administrator)]
@inject AnalyticsQueries Consultas

<PageTitle>@T["People — Administration"]</PageTitle>

<div class="container py-4">
    <nav aria-label="@T["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@T["People"]</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@T["Who has access to the platform"]</span>

            <form action="/admin/people" method="get" class="d-flex" role="search">
                <input class="form-control form-control-sm" type="search" name="q" value="@Q"
                       placeholder="@T["Search by email"]" aria-label="@T["Search a person by email"]" />
                <button class="btn btn-sm btn-outline-secondary ms-2" type="submit">@T["Search"]</button>
            </form>
        </div>

        @if (Lista.Count == 0)
        {
            <div class="card-body text-center text-body-secondary py-5">
                @(string.IsNullOrWhiteSpace(Q) ? T["Nobody has signed in yet."] : T["No one matches"])
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["Email"]</th>
                            <th scope="col">@T["Grants"]</th>
                            <th scope="col">@T["Videos watched"]</th>
                            <th scope="col">@T["Time watched"]</th>
                            <th scope="col">@T["Last sign-in"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pessoa in Lista)
                        {
                            <tr>
                                <td>
                                    <a href="/admin/people/@pessoa.UserId" class="text-decoration-none">@pessoa.Email</a>
                                    @if (pessoa.IsAdmin)
                                    {
                                        <span class="badge text-bg-primary ms-1">@T["Administrator"]</span>
                                    }
                                    @if (!pessoa.IsActive)
                                    {
                                        <span class="badge text-bg-secondary ms-1">@T["Disabled"]</span>
                                    }
                                </td>
                                <td>@pessoa.ActiveGrants</td>
                                <td>@pessoa.VideosWatched</td>
                                <td>@Tempo(pessoa.WatchSeconds)</td>
                                <td class="small">
                                    @(pessoa.LastSeenAt is { } quando
                                        ? quando.ToLocalTime().ToString("g")
                                        : T["never signed in"])
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    private IReadOnlyList<Person> Lista = [];

    protected override async Task OnInitializedAsync() =>
        Lista = await Consultas.PeopleAsync(Q, cancellationToken: Http.RequestAborted);

    private static string Tempo(double segundos)
    {
        var tempo = TimeSpan.FromSeconds(Math.Max(0, segundos));

        return tempo.TotalHours >= 1
            ? $"{(int)tempo.TotalHours}h{tempo.Minutes:D2}"
            : $"{tempo.Minutes}min";
    }
}
