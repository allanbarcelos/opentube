@page "/admin/support"
@using OpenTube.Domain.Enums
@using OpenTube.Infrastructure.Support
@attribute [Authorize(Policy = Policies.Administrator)]
@inject SupportService Servico

<PageTitle>@T["Support — Administration"]</PageTitle>

<div class="container py-4">
    <nav aria-label="@T["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@T["Support"]</li>
        </ol>
    </nav>

    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a class="nav-link @(Filtro is null ? "active" : "")" href="/admin/support">@T["All"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Filtro == SupportStatus.Open ? "active" : "")" href="/admin/support?status=open">
                @T["Waiting for a reply"]
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Filtro == SupportStatus.Answered ? "active" : "")" href="/admin/support?status=answered">
                @T["Answered ones"]
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Filtro == SupportStatus.Closed ? "active" : "")" href="/admin/support?status=closed">
                @T["Closed ones"]
            </a>
        </li>
    </ul>

    <div class="card">
        @if (Fila.Count == 0)
        {
            <div class="card-body text-center text-body-secondary py-5">
                @T["No conversations here."]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["Who"]</th>
                            <th scope="col">@T["Video"]</th>
                            <th scope="col">@T["Last message"]</th>
                            <th scope="col">@T["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Fila)
                        {
                            <tr>
                                <td>
                                    <a href="/admin/support/@item.Thread.Id" class="text-decoration-none">
                                        @item.UserEmail
                                    </a>
                                    @if (item.Thread.NeedsAdminAttention)
                                    {
                                        <span class="badge text-bg-danger ms-1">@T["new"]</span>
                                    }
                                </td>
                                <td class="small">@item.VideoTitle</td>
                                <td class="small">@item.Thread.LastMessageAt.ToLocalTime().ToString("g")</td>
                                <td><span class="badge @Classe(item.Thread.Status)">@Texto(item.Thread.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "status")]
    private string? Situacao { get; set; }

    private SupportStatus? Filtro => Situacao switch
    {
        "open" => SupportStatus.Open,
        "answered" => SupportStatus.Answered,
        "closed" => SupportStatus.Closed,
        _ => null
    };

    private IReadOnlyList<SupportThreadView> Fila = [];

    protected override async Task OnInitializedAsync() =>
        Fila = await Servico.QueueAsync(Filtro, cancellationToken: Http.RequestAborted);

    private string Texto(SupportStatus situacao) => situacao switch
    {
        SupportStatus.Answered => T["Answered"],
        SupportStatus.Closed => T["Closed"],
        _ => T["Waiting"]
    };

    private static string Classe(SupportStatus situacao) => situacao switch
    {
        SupportStatus.Answered => "text-bg-success",
        SupportStatus.Closed => "text-bg-secondary",
        _ => "text-bg-warning"
    };
}
