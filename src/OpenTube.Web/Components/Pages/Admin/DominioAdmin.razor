@page "/admin/domains/{domainId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Access
@using OpenTube.Infrastructure.Domains
@attribute [Authorize(Policy = Policies.Administrator)]
@inject DomainService Servico
@inject GrantService Concessoes
@inject NavigationManager Navegacao

<PageTitle>@(Dominio?.Name ?? T["Domain"]) — @T["Administration"]</PageTitle>

<div class="container py-4">
    @if (Dominio is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="@T["Breadcrumb"]">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
                <li class="breadcrumb-item"><a href="/admin/domains">@T["Domains"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Dominio.Name</li>
            </ol>
        </nav>

        @foreach (var aviso in Avisos)
        {
            <div class="alert alert-success" role="status">@aviso</div>
        }
        @if (Falhou)
        {
            <div class="alert alert-warning" role="alert">
                @T["The record was not found yet. DNS can take a few minutes to propagate."]
            </div>
        }
        @if (SemResponsavel)
        {
            <div class="alert alert-warning" role="alert">
                @T["Register the owner's email before sending the link."]
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="alert alert-danger" role="alert">@Erro</div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                @if (!Dominio.IsVerified)
                {
                    <div class="card border-warning mb-4">
                        <div class="card-header">@T["Prove ownership of the domain"]</div>
                        <div class="card-body">
                            <p>@T.Format("Publish this record in the DNS of {0}:", Dominio.Name)</p>

                            <dl class="row mb-3">
                                <dt class="col-sm-3">@T["Type"]</dt>
                                <dd class="col-sm-9"><code>TXT</code></dd>

                                <dt class="col-sm-3">@T["Name"]</dt>
                                <dd class="col-sm-9"><code class="user-select-all">@Dominio.VerificationRecordName</code></dd>

                                <dt class="col-sm-3">@T["Value"]</dt>
                                <dd class="col-sm-9"><code class="user-select-all">@Dominio.ExpectedRecordValue</code></dd>
                            </dl>

                            <div class="d-flex gap-2">
                                <form method="post" action="/admin/domains/@Dominio.Id/verify">
                                    <AntiforgeryToken />
                                    <button class="btn btn-primary" type="submit">@T["I've published it, check"]</button>
                                </form>

                                <form method="post" action="/admin/domains/@Dominio.Id/reissue">
                                    <AntiforgeryToken />
                                    <button class="btn btn-outline-secondary" type="submit">@T["Generate another token"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>@T["Entry page"]</span>
                            <span class="badge @(Dominio.EntryAvailable ? "text-bg-success" : "text-bg-secondary")">
                                @(Dominio.EntryAvailable ? T["Live"] : T["Closed"])
                            </span>
                        </div>
                        <div class="card-body">
                            <p class="mb-2">@T["Address to forward to people at the domain:"]</p>
                            <input class="form-control font-monospace mb-3" value="@Endereco" readonly
                                   onclick="this.select()" aria-label="@T["Entry address"]" />

                            <form method="post" action="/admin/domains/@Dominio.Id/send-link">
                                <AntiforgeryToken />
                                <button class="btn btn-outline-primary" type="submit"
                                        disabled="@(Dominio.ContactEmail is null)">
                                    @T["Send to the owner"]
                                </button>
                                @if (Dominio.ContactEmail is not null)
                                {
                                    <span class="ms-2 small text-body-secondary">@Dominio.ContactEmail</span>
                                }
                            </form>
                        </div>
                    </div>
                }

                <div class="card">
                    <div class="card-header">@T["Who at the domain already has access"]</div>

                    @if (ConcessoesDoDominio.Count == 0)
                    {
                        <div class="card-body text-body-secondary">
                            @T["No grant for this domain yet. Grant one on a video or collection page; the entry page alone does not open content."]
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var concessao in ConcessoesDoDominio)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@AlvoTexto(concessao)</span>
                                    <span class="small text-body-secondary">
                                        @(concessao.IsRevoked ? T["Revoked"] : T["in effect"])
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card">
                    <div class="card-header">@T["Configuration"]</div>
                    <div class="card-body">
                        <form method="post" action="/admin/domains/@Dominio.Id/save">
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label" for="endereco">@T["Entry address"]</label>
                                <div class="input-group">
                                    <span class="input-group-text">/entry/</span>
                                    <input class="form-control" id="endereco" name="endereco"
                                           value="@Dominio.EntrySlug" maxlength="120" />
                                </div>
                                <div class="form-text">
                                    @T["Change this if you don't want the address to reveal that the organization uses the platform."]
                                </div>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="portaAtiva" name="portaAtiva"
                                       checked="@Dominio.EntryEnabled" />
                                <label class="form-check-label" for="portaAtiva">@T["Entry page is live"]</label>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="permitidos">@T["Allowed addresses"]</label>
                                <textarea class="form-control" id="permitidos" name="permitidos" rows="3"
                                          placeholder="@T["leave empty to accept any email at the domain"]">@string.Join(", ", Dominio.AllowedEmails)</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="responsavel">@T["Owner email"]</label>
                                <input class="form-control" id="responsavel" name="responsavel" type="email"
                                       value="@Dominio.ContactEmail" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="nota">@T["Note"]</label>
                                <input class="form-control" id="nota" name="nota" maxlength="500"
                                       value="@Dominio.Note" />
                            </div>

                            <button class="btn btn-primary w-100" type="submit">@T["Save"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid DomainId { get; set; }

    [SupplyParameterFromQuery(Name = "cadastrado")]
    private string? Cadastrado { get; set; }

    [SupplyParameterFromQuery(Name = "verificado")]
    private string? Verificado { get; set; }

    [SupplyParameterFromQuery(Name = "reemitido")]
    private string? Reemitido { get; set; }

    [SupplyParameterFromQuery(Name = "salvo")]
    private string? Salvo { get; set; }

    [SupplyParameterFromQuery(Name = "linkEnviado")]
    private string? LinkEnviado { get; set; }

    [SupplyParameterFromQuery(Name = "falhou")]
    private string? FalhouBruto { get; set; }

    [SupplyParameterFromQuery(Name = "semResponsavel")]
    private string? SemResponsavelBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Falhou => FalhouBruto == "1";
    private bool SemResponsavel => SemResponsavelBruto == "1";

    private VerifiedDomain? Dominio;

    private string Endereco = string.Empty;

    private IReadOnlyList<AccessGrant> ConcessoesDoDominio = [];

    private IEnumerable<string> Avisos
    {
        get
        {
            if (Cadastrado == "1") yield return T["Domain registered. Publish the DNS record to prove ownership."];
            if (Verificado == "1") yield return T["Domain verified. The entry page is live."];
            if (Reemitido == "1") yield return T["Token reissued. Publish the new value and check again."];
            if (Salvo == "1") yield return T["Configuration saved."];
            if (LinkEnviado == "1") yield return T["Link sent to the owner."];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Dominio = await Servico.FindAsync(DomainId, Http.RequestAborted);

        if (Dominio is null)
        {
            Navegacao.NotFound();
            return;
        }

        Endereco = Servico.EntryUrl(Dominio);
        ConcessoesDoDominio = await Concessoes.ListForDomainAsync(Dominio.Name, Http.RequestAborted);
    }

    private string AlvoTexto(AccessGrant concessao) => concessao.TargetType switch
    {
        OpenTube.Domain.Enums.GrantTargetType.All => T["The whole library"],
        OpenTube.Domain.Enums.GrantTargetType.Collection => T["A collection"],
        _ => T["A video"]
    };
}
