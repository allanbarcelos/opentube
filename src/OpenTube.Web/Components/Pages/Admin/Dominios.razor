@page "/admin/dominios"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Domains
@attribute [Authorize(Policy = Policies.Administrator)]
@inject DomainService Servico

<PageTitle>Domínios — Administração</PageTitle>

<div class="container py-4">
    <nav aria-label="Trilha de navegação">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">Administração</a></li>
            <li class="breadcrumb-item active" aria-current="page">Domínios</li>
        </ol>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="alert alert-danger" role="alert">@Erro</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">Domínios cadastrados</div>

                @if (Lista.Count == 0)
                {
                    <div class="card-body text-center text-body-secondary py-5">
                        Nenhum domínio ainda.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var dominio in Lista)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                                <div>
                                    <a href="/admin/dominios/@dominio.Id" class="text-decoration-none fw-semibold">
                                        @dominio.Name
                                    </a>
                                    @if (dominio.EntryAvailable)
                                    {
                                        <code class="d-block small text-body-secondary">/d/@dominio.EntrySlug</code>
                                    }
                                </div>
                                <div class="text-nowrap">
                                    @if (dominio.IsVerified)
                                    {
                                        <span class="badge text-bg-success">Verificado</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Aguardando DNS</span>
                                    }

                                    @if (dominio.IsVerified && !dominio.EntryEnabled)
                                    {
                                        <span class="badge text-bg-secondary">Porta fechada</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">Cadastrar domínio</div>
                <div class="card-body">
                    <form method="post" action="/admin/dominios/cadastrar">
                        <AntiforgeryToken />

                        <div class="mb-3">
                            <label class="form-label" for="dominio">Domínio</label>
                            <input class="form-control" id="dominio" name="dominio" required
                                   placeholder="barcelos.dev" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="responsavel">Email do responsável</label>
                            <input class="form-control" id="responsavel" name="responsavel" type="email"
                                   placeholder="ti@barcelos.dev" />
                            <div class="form-text">Recebe o endereço da porta de entrada para repassar.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="nota">Anotação</label>
                            <input class="form-control" id="nota" name="nota" maxlength="500" />
                        </div>

                        <button class="btn btn-primary w-100" type="submit">Cadastrar</button>
                    </form>
                </div>
            </div>

            <div class="alert alert-light border mt-3 small mb-0">
                O domínio só passa a valer depois de comprovado por um registro DNS. Sem essa etapa,
                qualquer um poderia cadastrar um domínio alheio e liberar o acervo para os usuários dele.
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private IReadOnlyList<VerifiedDomain> Lista = [];

    protected override async Task OnInitializedAsync() =>
        Lista = await Servico.ListAsync(Http.RequestAborted);
}
