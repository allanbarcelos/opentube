@page "/admin"
@using OpenTube.Infrastructure.Playback
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject VideoCatalog Catalogo
@inject AdminVideoService Admin
@inject CurrentViewer Espectadores
@inject OpenTube.Infrastructure.Support.SupportService Suporte

<PageTitle>@T["Administration — OpenTube"]</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">@T["Administration"]</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/admin/collections">@T["Collections"]</a>
            <a class="btn btn-outline-secondary" href="/admin/domains">@T["Domains"]</a>
            <a class="btn btn-outline-secondary" href="/admin/people">@T["People"]</a>
            <a class="btn btn-outline-secondary" href="/admin/audit">@T["Audit"]</a>
            <a class="btn btn-outline-secondary" href="/admin/watermark">@T["Watermark"]</a>
            <a class="btn btn-outline-secondary position-relative" href="/admin/support">
                @T["Support"]
                @if (SuportePendente > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">
                        @SuportePendente
                    </span>
                }
            </a>
            <a class="btn btn-primary" href="/admin/upload">@T["Upload video"]</a>
        </div>
    </div>

    @if (Excluido)
    {
        <div class="alert alert-success" role="status">@T["Video deleted."]</div>
    }

    <div class="row g-3 mb-4">
        @foreach (var indicador in Indicadores)
        {
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <p class="text-body-secondary small mb-1">@indicador.Rotulo</p>
                        <p class="h4 mb-0">@indicador.Valor</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Acervo</span>

            <form action="/admin" method="get" class="d-flex" role="search">
                <input class="form-control form-control-sm" type="search" name="q" value="@Q"
                       placeholder="Filtrar" aria-label="Filtrar o acervo" />
                <button class="btn btn-sm btn-outline-secondary ms-2" type="submit">Filtrar</button>
            </form>
        </div>

        @if (Resultado.Items.Count == 0)
        {
            <div class="card-body text-center text-body-secondary py-5">
                @T["No videos here yet."]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["Title"]</th>
                            <th scope="col">@T["Status"]</th>
                            <th scope="col">@T["Visibility"]</th>
                            <th scope="col">@T["Duration"]</th>
                            <th scope="col">@T["Uploaded on"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var video in Resultado.Items)
                        {
                            <tr>
                                <td>
                                    <a href="/admin/videos/@video.Id" class="text-decoration-none">@video.Title</a>
                                </td>
                                <td><span class="badge @EstadoClasse(video)">@EstadoTexto(video)</span></td>
                                <td><span class="badge @VisibilidadeClasse(video)">@VisibilidadeTexto(video)</span></td>
                                <td>@(video.Status == (int)VideoStatus.Ready ? video.DurationLabel : "—")</td>
                                <td>@video.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <Paginacao Resultado="Resultado" BasePath="/admin" Termo="Q" />
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Pagina { get; set; }

    [SupplyParameterFromQuery(Name = "excluido")]
    private string? ExcluidoBruto { get; set; }

    private bool Excluido => ExcluidoBruto == "1";

    private PagedResult<VideoSummary> Resultado = PagedResult<VideoSummary>.Empty(VideoCatalog.DefaultPageSize);

    private readonly List<(string Rotulo, int Valor)> Indicadores = [];

    private int SuportePendente;

    protected override async Task OnInitializedAsync()
    {
        var espectador = await Espectadores.GetAsync(Http.RequestAborted);

        Resultado = await Catalogo.BrowseAsync(espectador, Q, Pagina ?? 1, cancellationToken: Http.RequestAborted);

        var fila = await Admin.QueueSummaryAsync(Http.RequestAborted);
        SuportePendente = await Suporte.PendingCountAsync(Http.RequestAborted);

        Indicadores.Clear();
        Indicadores.Add((T["Videos in the library"], Resultado.Total));
        Indicadores.Add((T["Queued"], fila.GetValueOrDefault(JobStatus.Pending)));
        Indicadores.Add((T["Processing"], fila.GetValueOrDefault(JobStatus.Running)));
        Indicadores.Add((T["Failures"], fila.GetValueOrDefault(JobStatus.Failed)));
        Indicadores.Add((T["Support waiting"], SuportePendente));
    }

    private string EstadoTexto(VideoSummary video) => (VideoStatus)video.Status switch
    {
        VideoStatus.Draft => T["Draft"],
        VideoStatus.Uploaded => T["Queued"],
        VideoStatus.Processing => T["Processing"],
        VideoStatus.Ready => T["Ready"],
        _ => T["Failed"]
    };

    private static string EstadoClasse(VideoSummary video) => (VideoStatus)video.Status switch
    {
        VideoStatus.Ready => "text-bg-success",
        VideoStatus.Failed => "text-bg-danger",
        VideoStatus.Processing => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private string VisibilidadeTexto(VideoSummary video) => (VideoVisibility)video.Visibility switch
    {
        VideoVisibility.Public => T["Public"],
        VideoVisibility.Restricted => T["Restricted"],
        _ => T["Private"]
    };

    private static string VisibilidadeClasse(VideoSummary video) => (VideoVisibility)video.Visibility switch
    {
        VideoVisibility.Public => "text-bg-success",
        VideoVisibility.Restricted => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}
