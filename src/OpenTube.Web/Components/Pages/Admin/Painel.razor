@page "/admin"
@using OpenTube.Infrastructure.Playback
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject VideoCatalog Catalogo
@inject AdminVideoService Admin
@inject CurrentViewer Espectadores
@inject OpenTube.Infrastructure.Support.SupportService Suporte
@inject ProcessingQueueService Fila

<PageTitle>@T["Administration — OpenTube"]</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">@T["Administration"]</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/admin/collections">@T["Collections"]</a>
            <a class="btn btn-outline-secondary" href="/admin/people">@T["People"]</a>
            <a class="btn btn-outline-secondary" href="/admin/audit">@T["Audit"]</a>
            <a class="btn btn-outline-secondary" href="/admin/watermark">@T["Watermark"]</a>
            <a class="btn btn-outline-secondary position-relative" href="/admin/support">
                @T["Support"]
                @if (SuportePendente > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">
                        @SuportePendente
                    </span>
                }
            </a>
            <a class="btn btn-primary" href="/admin/upload">@T["Upload video"]</a>
        </div>
    </div>

    @if (Excluido)
    {
        <div class="alert alert-success" role="status">@T["Video deleted."]</div>
    }
    @if (Cancelado)
    {
        <div class="alert alert-success" role="status">@T["Job cancelled."]</div>
    }
    @if (Descartado)
    {
        <div class="alert alert-success" role="status">@T["Job removed from the list."]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="alert alert-danger" role="alert">@Erro</div>
    }

    @* Cada indicador leva à lista do que ele conta; o selecionado fica destacado. *@
    <div class="row g-3 mb-4">
        @foreach (var indicador in Indicadores)
        {
            var ativo = indicador.Visao is not null && indicador.Visao == Visao;
            <div class="col-6 col-lg">
                <a class="card h-100 text-decoration-none card-indicador @(ativo ? "border-primary border-2" : "")"
                   href="@indicador.Destino" data-indicador="@(indicador.Visao ?? "support")"
                   aria-current="@(ativo ? "page" : null)">
                    <div class="card-body">
                        <p class="text-body-secondary small mb-1">@indicador.Rotulo</p>
                        <p class="h4 mb-0 @indicador.Cor">@indicador.Valor</p>
                    </div>
                </a>
            </div>
        }
    </div>

    @if (Visao != VisaoAcervo)
    {
        <div class="card" data-fila="@Visao">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>@TituloDaFila</span>
                <span class="small text-body-secondary">@T["Updates when the page is reloaded."]</span>
            </div>

            @if (Trabalhos.Count == 0)
            {
                <div class="card-body text-center text-body-secondary py-5">@T["Nothing here."]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="small text-body-secondary">
                                <th scope="col">@T["Job"]</th>
                                <th scope="col">@T["Video"]</th>
                                <th scope="col">@T["When"]</th>
                                <th scope="col">@T["Attempts"]</th>
                                <th scope="col">@T["Details"]</th>
                                <th scope="col" class="text-end"><span class="visually-hidden">@T["Actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trabalho in Trabalhos)
                            {
                                <tr data-trabalho="@trabalho.Id">
                                    <td>
                                        <span class="fw-semibold">@NomeDoTrabalho(trabalho)</span>
                                        @if (!ProcessingQueueService.IsCancellable(trabalho.Kind))
                                        {
                                            <span class="d-block small text-body-secondary">@T["Automatic maintenance"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (trabalho.VideoId is { } videoId)
                                        {
                                            <a href="/admin/videos/@videoId" class="text-decoration-none">@trabalho.VideoTitle</a>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                    </td>
                                    <td class="small">@Quando(trabalho)</td>
                                    <td class="small">@trabalho.Attempts / @OpenTube.Domain.Entities.ProcessingJob.MaxAttempts</td>
                                    <td class="small">
                                        @if (trabalho.Status is JobStatus.Running && trabalho.LockedBy is not null)
                                        {
                                            <span class="text-body-secondary">@T["Worker"]: <code>@trabalho.LockedBy</code></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(trabalho.LastError))
                                        {
                                            <span class="d-block text-danger text-truncate" style="max-width: 24rem" title="@trabalho.LastError">@trabalho.LastError</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (trabalho.CanCancel)
                                        {
                                            <form method="post" action="/admin/queue/@trabalho.Id/cancel" class="d-inline"
                                                  onsubmit="return confirm(this.dataset.confirmar)"
                                                  data-confirmar="@T["Cancel this job? It will not run."]">
                                                <AntiforgeryToken />
                                                <button class="btn btn-sm btn-outline-danger" type="submit">@T["Cancel"]</button>
                                            </form>
                                        }
                                        @if (trabalho.Status is JobStatus.Failed)
                                        {
                                            <form method="post" action="/admin/queue/@trabalho.Id/dismiss" class="d-inline">
                                                <AntiforgeryToken />
                                                <button class="btn btn-sm btn-outline-secondary" type="submit">@T["Remove from the list"]</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Trabalhos.Count >= ProcessingQueueService.ListLimit)
                {
                    <div class="card-footer small text-body-secondary">
                        @T.Format("Showing the first {0}.", ProcessingQueueService.ListLimit)
                    </div>
                }
            }
        </div>
    }
    else
    {
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@T["Library"]</span>

            <form action="/admin" method="get" class="d-flex" role="search">
                <input class="form-control form-control-sm" type="search" name="q" value="@Q"
                       placeholder="@T["Filter"]" aria-label="@T["Filter the library"]" />
                <button class="btn btn-sm btn-outline-secondary ms-2" type="submit">@T["Filter"]</button>
            </form>
        </div>

        @if (Resultado.Items.Count == 0)
        {
            <div class="card-body text-center text-body-secondary py-5">
                @T["No videos here yet."]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["Title"]</th>
                            <th scope="col">@T["Status"]</th>
                            <th scope="col">@T["Visibility"]</th>
                            <th scope="col">@T["Duration"]</th>
                            <th scope="col">@T["Uploaded on"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var video in Resultado.Items)
                        {
                            <tr>
                                <td>
                                    <a href="/admin/videos/@video.Id" class="text-decoration-none">@video.Title</a>
                                </td>
                                <td><span class="badge @EstadoClasse(video)">@EstadoTexto(video)</span></td>
                                <td><span class="badge @VisibilidadeClasse(video)">@VisibilidadeTexto(video)</span></td>
                                <td>@(video.Status == (int)VideoStatus.Ready ? video.DurationLabel : "—")</td>
                                <td>@video.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <Paginacao Resultado="Resultado" BasePath="/admin" Termo="@Q" />
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Pagina { get; set; }

    [SupplyParameterFromQuery(Name = "excluido")]
    private string? ExcluidoBruto { get; set; }

    private bool Excluido => ExcluidoBruto == "1";

    [SupplyParameterFromQuery(Name = "view")]
    private string? VisaoBruta { get; set; }

    [SupplyParameterFromQuery(Name = "cancelado")]
    private string? CanceladoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "descartado")]
    private string? DescartadoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Cancelado => CanceladoBruto == "1";

    private bool Descartado => DescartadoBruto == "1";

    private const string VisaoAcervo = "library";

    /// <summary>A visão pedida; qualquer outra coisa cai no acervo, que é o padrão.</summary>
    private string Visao => VisaoBruta is "queued" or "processing" or "failed" ? VisaoBruta : VisaoAcervo;

    private JobStatus StatusDaVisao => Visao switch
    {
        "processing" => JobStatus.Running,
        "failed" => JobStatus.Failed,
        _ => JobStatus.Pending
    };

    private string TituloDaFila => Visao switch
    {
        "processing" => T["Processing"],
        "failed" => T["Failures"],
        _ => T["Queued"]
    };

    private PagedResult<VideoSummary> Resultado = PagedResult<VideoSummary>.Empty(VideoCatalog.DefaultPageSize);

    private IReadOnlyList<QueueItem> Trabalhos = [];

    private readonly List<(string Rotulo, int Valor, string? Visao, string Destino, string Cor)> Indicadores = [];

    private int SuportePendente;

    protected override async Task OnInitializedAsync()
    {
        var espectador = await Espectadores.GetAsync(Http.RequestAborted);

        Resultado = await Catalogo.BrowseAsync(espectador, Q, Pagina ?? 1, cancellationToken: Http.RequestAborted);

        var fila = await Admin.QueueSummaryAsync(Http.RequestAborted);
        SuportePendente = await Suporte.PendingCountAsync(Http.RequestAborted);

        if (Visao != VisaoAcervo)
            Trabalhos = await Fila.ListAsync(StatusDaVisao, Http.RequestAborted);

        var falhas = fila.GetValueOrDefault(JobStatus.Failed);

        Indicadores.Clear();
        Indicadores.Add((T["Videos in the library"], Resultado.Total, VisaoAcervo, "/admin", ""));
        Indicadores.Add((T["Queued"], fila.GetValueOrDefault(JobStatus.Pending), "queued", "/admin?view=queued", ""));
        Indicadores.Add((T["Processing"], fila.GetValueOrDefault(JobStatus.Running), "processing", "/admin?view=processing", ""));
        Indicadores.Add((T["Failures"], falhas, "failed", "/admin?view=failed", falhas > 0 ? "text-danger" : ""));
        Indicadores.Add((T["Support waiting"], SuportePendente, null, "/admin/support", ""));
    }

    private string NomeDoTrabalho(QueueItem trabalho) => trabalho.Kind switch
    {
        JobKind.Transcode => T["Video processing"],
        JobKind.Transcript => string.IsNullOrWhiteSpace(trabalho.Language) || trabalho.Language == "auto"
            ? T["Captions (automatic language)"]
            : T.Format("Captions ({0})", trabalho.Language),
        JobKind.AnalyticsRollup => T["Audience aggregation"],
        JobKind.StorageCleanup => T["Storage cleanup"],
        JobKind.RetireOutputs => T["Old versions cleanup"],
        _ => trabalho.Kind.ToString()
    };

    private string Quando(QueueItem trabalho)
    {
        var agora = DateTimeOffset.UtcNow;

        return trabalho.Status switch
        {
            JobStatus.Running when trabalho.StartedAt is { } inicio => T.Format("Started {0}", inicio.ToLocalTime().ToString("g")),
            JobStatus.Pending when trabalho.RunAfter > agora && trabalho.Attempts > 0 =>
                T.Format("Retry at {0}", trabalho.RunAfter.ToLocalTime().ToString("g")),
            JobStatus.Pending when trabalho.RunAfter > agora => T.Format("Scheduled for {0}", trabalho.RunAfter.ToLocalTime().ToString("g")),
            JobStatus.Pending => T.Format("Waiting since {0}", trabalho.CreatedAt.ToLocalTime().ToString("g")),
            _ => (trabalho.StartedAt ?? trabalho.CreatedAt).ToLocalTime().ToString("g")
        };
    }

    private string EstadoTexto(VideoSummary video) => (VideoStatus)video.Status switch
    {
        VideoStatus.Draft => T["Draft"],
        VideoStatus.Uploaded => T["Queued"],
        VideoStatus.Processing => T["Processing"],
        VideoStatus.Ready => T["Ready"],
        _ => T["Failed"]
    };

    private static string EstadoClasse(VideoSummary video) => (VideoStatus)video.Status switch
    {
        VideoStatus.Ready => "text-bg-success",
        VideoStatus.Failed => "text-bg-danger",
        VideoStatus.Processing => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private string VisibilidadeTexto(VideoSummary video) => (VideoVisibility)video.Visibility switch
    {
        VideoVisibility.Public => T["Public"],
        VideoVisibility.Restricted => T["Restricted"],
        _ => T["Private"]
    };

    private static string VisibilidadeClasse(VideoSummary video) => (VideoVisibility)video.Visibility switch
    {
        VideoVisibility.Public => "text-bg-success",
        VideoVisibility.Restricted => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}
