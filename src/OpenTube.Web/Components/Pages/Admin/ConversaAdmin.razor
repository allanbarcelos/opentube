@page "/admin/support/{threadId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Domain.Enums
@using OpenTube.Infrastructure.Persistence
@using OpenTube.Infrastructure.Support
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = Policies.Administrator)]
@inject SupportService Servico
@inject CurrentViewer Espectadores
@inject OpenTubeDbContext Db
@inject NavigationManager Navegacao

<PageTitle>@T["Conversation — Administration"]</PageTitle>

<div class="container py-4">
    @if (Conversa is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="@T["Breadcrumb"]">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
                <li class="breadcrumb-item"><a href="/admin/support">@T["Support"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Autor</li>
            </ol>
        </nav>

        @if (Encerrada)
        {
            <div class="alert alert-success" role="status">@T["Conversation closed."]</div>
        }
        @if (Reaberta)
        {
            <div class="alert alert-success" role="status">@T["Conversation reopened."]</div>
        }
        @if (Respondida)
        {
            <div class="alert alert-success" role="status">@T["Reply sent."]</div>
        }
        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="alert alert-danger" role="alert">@Erro</div>
        }

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@Autor</span>
                        <span class="badge @Classe">@Texto</span>
                    </div>

                    <div class="card-body">
                        @foreach (var mensagem in Conversa.Messages.OrderBy(m => m.CreatedAt))
                        {
                            <div class="mb-3">
                                <p class="small mb-1">
                                    <strong>@(mensagem.FromAdmin ? T["Administration"] : Autor)</strong>
                                    <span class="text-body-secondary ms-1">
                                        @mensagem.CreatedAt.ToLocalTime().ToString("g")
                                    </span>
                                </p>
                                <p class="mb-0" style="white-space: pre-wrap">@mensagem.Body</p>
                            </div>
                        }

                        @if (!Conversa.IsClosed)
                        {
                            <form method="post" action="/support/@Conversa.Id/reply" class="mt-4">
                                <AntiforgeryToken />
                                <input type="hidden" name="destino" value="/admin/support/@Conversa.Id" />

                                <div class="mb-2">
                                    <label class="form-label" for="resposta">@T["Your reply"]</label>
                                    <textarea class="form-control" id="resposta" name="mensagem" rows="4"
                                              maxlength="4000" required autofocus></textarea>
                                </div>

                                <button class="btn btn-primary" type="submit">@T["Reply"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header">@T["Context"]</div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Video"]</span>
                            <a href="/admin/videos/@Conversa.VideoId" class="text-decoration-none">@VideoTitulo</a>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Person"]</span>
                            <a href="/admin/people/@Conversa.UserId" class="text-decoration-none">@Autor</a>
                        </li>
                        @if (Conversa.TimestampSeconds is { } instante)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@T["Moment mentioned"]</span><span>@Tempo(instante)</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Opened on"]</span>
                            <span>@Conversa.CreatedAt.ToLocalTime().ToString("g")</span>
                        </li>
                    </ul>
                    <div class="card-body">
                        @if (Conversa.IsClosed)
                        {
                            <form method="post" action="/admin/support/@Conversa.Id/reopen">
                                <AntiforgeryToken />
                                <button class="btn btn-outline-secondary w-100" type="submit">@T["Reopen conversation"]</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" action="/admin/support/@Conversa.Id/close">
                                <AntiforgeryToken />
                                <button class="btn btn-outline-secondary w-100" type="submit">@T["Close conversation"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid ThreadId { get; set; }

    [SupplyParameterFromQuery(Name = "encerrada")]
    private string? EncerradaBruta { get; set; }

    [SupplyParameterFromQuery(Name = "reaberta")]
    private string? ReabertaBruta { get; set; }

    [SupplyParameterFromQuery(Name = "respondida")]
    private string? RespondidaBruta { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Encerrada => EncerradaBruta == "1";
    private bool Reaberta => ReabertaBruta == "1";
    private bool Respondida => RespondidaBruta == "1";

    private SupportThread? Conversa;

    private string Autor = string.Empty;

    private string VideoTitulo = string.Empty;

    private string Texto => Conversa?.Status switch
    {
        SupportStatus.Answered => T["Answered"],
        SupportStatus.Closed => T["Closed"],
        _ => T["Waiting for a reply"]
    };

    private string Classe => Conversa?.Status switch
    {
        SupportStatus.Answered => "text-bg-success",
        SupportStatus.Closed => "text-bg-secondary",
        _ => "text-bg-warning"
    };

    protected override async Task OnInitializedAsync()
    {
        var espectador = await Espectadores.GetAsync(Http.RequestAborted);

        Conversa = await Servico.FindAsync(ThreadId, espectador, Http.RequestAborted);

        if (Conversa is null)
        {
            Navegacao.NotFound();
            return;
        }

        Autor = await Db.Users
            .Where(u => u.Id == Conversa.UserId)
            .Select(u => u.Email)
            .FirstOrDefaultAsync(Http.RequestAborted) ?? T["unknown"];

        VideoTitulo = await Db.Videos
            .Where(v => v.Id == Conversa.VideoId)
            .Select(v => v.Title)
            .FirstOrDefaultAsync(Http.RequestAborted) ?? T["Removed video"];

        // Abrir a conversa já conta como leitura: o distintivo de pendência some da fila.
        await Servico.MarkReadAsync(ThreadId, espectador, Http.RequestAborted);
    }

    private static string Tempo(double segundos)
    {
        var tempo = TimeSpan.FromSeconds(Math.Max(0, segundos));

        return tempo.TotalHours >= 1
            ? $"{(int)tempo.TotalHours}:{tempo.Minutes:D2}:{tempo.Seconds:D2}"
            : $"{tempo.Minutes}:{tempo.Seconds:D2}";
    }
}
