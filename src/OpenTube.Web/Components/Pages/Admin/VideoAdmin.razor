@page "/admin/videos/{videoId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject AdminVideoService Admin
@inject OpenTube.Infrastructure.Services.CaptionService Legendas
@inject OpenTube.Infrastructure.Services.VideoChapterService Sumarios
@inject OpenTube.Infrastructure.Services.VideoRatingService Avaliacoes
@inject NavigationManager Navegacao

<PageTitle>@(Video?.Title ?? T["Video"]) — @T["Administration"]</PageTitle>

<div class="container py-4">
    @if (Video is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="@T["Breadcrumb"]">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Video.Title</li>
            </ol>
        </nav>

        @if (Salvo)
        {
            <div class="alert alert-success" role="status">@T["Changes saved."]</div>
        }
        @if (Enfileirado)
        {
            <div class="alert alert-success" role="status">@T["The video is back in the processing queue."]</div>
        }
        @if (Restaurado)
        {
            <div class="alert alert-success" role="status">@T["Video restored. It is still private."]</div>
        }
        @if (Legenda == "enviada")
        {
            <div class="alert alert-success" role="status">@T["Caption uploaded."]</div>
        }
        @if (Legenda == "pedida")
        {
            <div class="alert alert-success" role="status">
                @T["Transcription is queued. The caption shows up here when it finishes."]
            </div>
        }
        @if (Legenda == "removida")
        {
            <div class="alert alert-success" role="status">@T["Caption removed."]</div>
        }
        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="alert alert-danger" role="alert">@Erro</div>
        }
        @if (Video.IsDeleted)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>@T["This video is deleted and is hidden from everyone."]</span>
                <form method="post" action="/admin/videos/@Video.Id/restore">
                    <AntiforgeryToken />
                    <button class="btn btn-sm btn-outline-dark" type="submit">@T["Restore"]</button>
                </form>
            </div>
        }

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link @(Aba is null or "" ? "active" : "")" href="/admin/videos/@Video.Id">@T["Configuration"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(MostrarLegendas ? "active" : "")" href="/admin/videos/@Video.Id?tab=captions">
                    @T["Captions"]
                    @if (QuantasLegendas > 0)
                    {
                        <span class="badge rounded-pill text-bg-secondary ms-1">@QuantasLegendas</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(MostrarAcesso ? "active" : "")" href="/admin/videos/@Video.Id?tab=access">@T["Access"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(MostrarAudiencia ? "active" : "")" href="/admin/videos/@Video.Id?tab=audience">@T["Audience"]</a>
            </li>
        </ul>

        @if (MostrarAudiencia)
        {
            <PainelDeAudiencia VideoId="Video.Id" />
        }
        else if (MostrarAcesso)
        {
            @if (Video.Visibility != VideoVisibility.Restricted)
            {
                <div class="alert alert-info small" role="note">
                    @(Video.Visibility == VideoVisibility.Public
                        ? T["This video is public: anyone can watch it, with or without an invitation. Invitations matter while it is restricted."]
                        : T["This video is private: invitations only take effect when its visibility is Restricted, in the Configuration tab."])
                </div>
            }
            <PainelDeConvites TargetType="GrantTargetType.Video" TargetId="Video.Id" Largo="true" />
        }
        else if (MostrarLegendas)
        {
            <PainelDeLegendas VideoId="Video.Id" />
        }
        else
        {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header">@T["Video details"]</div>
                    <div class="card-body">
                        <form method="post" action="/admin/videos/@Video.Id/save">
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label" for="titulo">@T["Title"]</label>
                                <input class="form-control" id="titulo" name="titulo" value="@Video.Title"
                                       maxlength="300" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="descricao">@T["Description"]</label>
                                <textarea class="form-control" id="descricao" name="descricao" rows="4"
                                          maxlength="10000">@Video.Description</textarea>
                            </div>

                            @* O etiquetas.js troca o campo por badges; o valor segue separado por vírgula. *@
                            <div class="mb-3" data-etiquetas data-limite="30"
                                 data-remover="@T["Remove the tag {0}"]" data-placeholder="@T["Type a tag and press Enter or comma"]">
                                <label class="form-label" for="etiquetas">@T["Tags"]</label>
                                <input class="form-control" id="etiquetas" name="etiquetas" data-etiquetas-valor
                                       aria-describedby="ajuda-etiquetas" value="@string.Join(", ", Video.Tags)" />
                                <div class="form-text" id="ajuda-etiquetas">@T["Enter, comma or semicolon adds the tag; up to 30. They are included in search."]</div>
                            </div>

                            <fieldset class="mb-3">
                                <legend class="form-label">@T["Visibility"]</legend>

                                @foreach (var opcao in Opcoes)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="visibilidade"
                                               id="visibilidade-@((int)opcao.Valor)" value="@((int)opcao.Valor)"
                                               checked="@(Video.Visibility == opcao.Valor)"
                                               disabled="@(!Video.IsPlayable && opcao.Valor != VideoVisibility.Private)" />
                                        <label class="form-check-label" for="visibilidade-@((int)opcao.Valor)">
                                            <strong>@opcao.Rotulo</strong>
                                            <span class="d-block small text-body-secondary">@opcao.Explicacao</span>
                                        </label>
                                    </div>
                                }

                                @if (!Video.IsPlayable)
                                {
                                    <div class="form-text">
                                        @T["Only a ready video can stop being private."]
                                    </div>
                                }
                            </fieldset>

                            <button class="btn btn-primary" type="submit">@T["Save"]</button>
                            @if (Video.IsPlayable)
                            {
                                <a class="btn btn-outline-secondary ms-2" href="/watch/@Video.Slug">@T["View the video page"]</a>
                            }
                        </form>
                    </div>
                </div>

                @* Sumário: linhas de tempo e título, acrescentadas e removidas pelo sumario.js. *@
                <div class="card mt-4" id="sumario" data-sumario-editor>
                    <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                        <span>@T["Chapters"]</span>
                        <span class="small text-body-secondary">@T["Shown next to the video and on the chapter bar"]</span>
                    </div>
                    <div class="card-body">
                        @if (SumarioSalvo)
                        {
                            <div class="alert alert-success" role="status">@T["Chapters saved."]</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ErroDoSumario))
                        {
                            <div class="alert alert-danger" role="alert">@ErroDoSumario</div>
                        }

                        <p class="form-text mt-0">
                            @T["Each chapter goes from its start to the start of the next one. Write the start like 0:00, 5:10 or 1:05:10; the order is fixed by time when saving. Leave it empty to remove the chapters."]
                        </p>

                        <form method="post" action="/admin/videos/@Video.Id/chapters">
                            <AntiforgeryToken />

                            <div data-sumario-linhas>
                                @foreach (var capitulo in LinhasDoSumario)
                                {
                                    <div class="row g-2 mb-2" data-sumario-linha>
                                        <div class="col-4 col-sm-3">
                                            <input class="form-control form-control-sm font-monospace" name="inicio"
                                                   value="@capitulo.Inicio" placeholder="0:00" aria-label="@T["Start"]" />
                                        </div>
                                        <div class="col">
                                            <input class="form-control form-control-sm" name="titulo" value="@capitulo.Titulo"
                                                   maxlength="@OpenTube.Domain.Media.VideoChapters.MaxTitleLength"
                                                   placeholder="@T["Chapter title"]" aria-label="@T["Chapter title"]" />
                                        </div>
                                        <div class="col-auto">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" data-sumario-remover
                                                    title="@T["Remove"]" aria-label="@T["Remove"]"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <template data-sumario-modelo>
                                <div class="row g-2 mb-2" data-sumario-linha>
                                    <div class="col-4 col-sm-3">
                                        <input class="form-control form-control-sm font-monospace" name="inicio"
                                               placeholder="0:00" aria-label="@T["Start"]" />
                                    </div>
                                    <div class="col">
                                        <input class="form-control form-control-sm" name="titulo"
                                               maxlength="@OpenTube.Domain.Media.VideoChapters.MaxTitleLength"
                                               placeholder="@T["Chapter title"]" aria-label="@T["Chapter title"]" />
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-sumario-remover
                                                title="@T["Remove"]" aria-label="@T["Remove"]"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </template>

                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-primary" type="button" data-sumario-acrescentar><i class="bi bi-plus-lg" aria-hidden="true"></i> @T["Add chapter"]</button>
                                <button class="btn btn-sm btn-primary" type="submit">@T["Save chapters"]</button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>

            <div class="col-lg-5">
                <div class="card mb-3">
                    <div class="card-header">@T["Processing"]</div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["State"]</span><span class="badge @EstadoClasse">@EstadoTexto</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Duration"]</span><span>@(Video.IsPlayable ? DuracaoTexto : "—")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Resolution"]</span>
                            <span>@(Video.Width > 0 ? $"{Video.Width}×{Video.Height}" : "—")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Original size"]</span><span>@TamanhoTexto</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Address"]</span><code class="small">/watch/@Video.Slug</code>
                        </li>
                    </ul>
                    <div class="card-body">
                        <form method="post" action="/admin/videos/@Video.Id/reprocess">
                            <AntiforgeryToken />
                            <button class="btn btn-outline-secondary w-100" type="submit">
                                @T["Reprocess from the original"]
                            </button>
                        </form>
                    </div>
                </div>

                @* Avaliação de utilidade: só a administração vê o conjunto das notas. *@
                <div class="card mb-3" id="avaliacoes" data-avaliacoes>
                    <div class="card-header">@T["Usefulness"]</div>
                    <div class="card-body">
                        @if (Notas.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">@T["No ratings yet."]</p>
                        }
                        else
                        {
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                <span class="h3 mb-0" data-media>@Notas.Average!.Value.ToString("0.0")</span>
                                <i class="bi bi-star-fill text-warning" aria-hidden="true"></i>
                                <span class="small text-body-secondary">@T.Format("{0} rating(s)", Notas.Count)</span>
                            </div>
                            @for (var nota = 5; nota >= 1; nota--)
                            {
                                var quantas = Notas.Distribution[nota - 1];
                                var parte = Notas.Count == 0 ? 0 : quantas * 100 / Notas.Count;
                                <div class="d-flex align-items-center gap-2 small mb-1" data-nota="@nota">
                                    <span class="text-nowrap" style="width: 2.5rem">@nota <i class="bi bi-star-fill text-warning" aria-hidden="true"></i></span>
                                    <div class="progress flex-grow-1" role="progressbar" style="height: 0.5rem"
                                         aria-valuenow="@parte" aria-valuemin="0" aria-valuemax="100"
                                         aria-label="@T.Format("{0} of 5", nota)">
                                        <div class="progress-bar bg-warning" style="width: @parte%"></div>
                                    </div>
                                    <span class="text-body-secondary text-end" style="width: 2rem">@quantas</span>
                                </div>
                            }
                        }
                        <p class="form-text mb-0 mt-2">@T["How useful the video was, from 1 to 5, according to who watched it. Viewers only see their own rating."]</p>
                    </div>
                </div>

                @if (!Video.IsDeleted)
                {
                    <div class="card border-danger">
                        <div class="card-header text-danger">@T["Delete"]</div>
                        <div class="card-body">
                            <p class="small text-body-secondary">
                                @T["The video leaves the library and access immediately. The record stays so the viewing history still makes sense."]
                            </p>
                            <form method="post" action="/admin/videos/@Video.Id/delete">
                                <AntiforgeryToken />
                                <ConfirmacaoDeExclusao Id="confirmar-exclusao-video" Rotulo="@T["Delete video"]">
                                    <p class="mb-0">@T["Delete this video? It leaves the library and access immediately. You can restore it later from this page."]</p>
                                </ConfirmacaoDeExclusao>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
        }
    }
</div>

@code {
    private (VideoVisibility Valor, string Rotulo, string Explicacao)[] Opcoes =>
    [
        (VideoVisibility.Private, T["Private"], T["Administrators only."]),
        (VideoVisibility.Public, T["Public"], T["Any visitor, without signing in."]),
        (VideoVisibility.Restricted, T["Restricted"], T["Only people with an access grant."])
    ];

    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid VideoId { get; set; }

    [SupplyParameterFromQuery(Name = "salvo")]
    private string? SalvoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "enfileirado")]
    private string? EnfileiradoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "restaurado")]
    private string? RestauradoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Aba { get; set; }

    [SupplyParameterFromQuery(Name = "sumario")]
    private string? SumarioBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro-sumario")]
    private string? ErroDoSumario { get; set; }

    private bool SumarioSalvo => SumarioBruto == "1";

    /// <summary>Linhas do editor: os capítulos salvos, ou uma primeira linha em 0:00 para começar.</summary>
    private IReadOnlyList<(string Inicio, string Titulo)> LinhasDoSumario = [];

    /// <summary>Resultado da última ação nas legendas: enviada, pedida ou removida.</summary>
    [SupplyParameterFromQuery(Name = "legenda")]
    private string? Legenda { get; set; }

    private bool MostrarAudiencia => Aba == "audience";

    private bool MostrarLegendas => Aba == "captions";

    private bool MostrarAcesso => Aba == "access";


    private bool Salvo => SalvoBruto == "1";
    private bool Enfileirado => EnfileiradoBruto == "1";
    private bool Restaurado => RestauradoBruto == "1";

    private Video? Video;

    private int QuantasLegendas;

    private OpenTube.Infrastructure.Services.RatingSummary Notas = OpenTube.Infrastructure.Services.RatingSummary.Empty;

    private string EstadoTexto => Video?.Status switch
    {
        VideoStatus.Draft => T["Waiting for the file"],
        VideoStatus.Uploaded => T["Queued"],
        VideoStatus.Processing => T["Processing"],
        VideoStatus.Ready => T["Ready"],
        _ => T["Failed"]
    };

    private string EstadoClasse => Video?.Status switch
    {
        VideoStatus.Ready => "text-bg-success",
        VideoStatus.Failed => "text-bg-danger",
        VideoStatus.Processing => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private string DuracaoTexto
    {
        get
        {
            var tempo = TimeSpan.FromSeconds(Video?.DurationSeconds ?? 0);

            return tempo.TotalHours >= 1
                ? $"{(int)tempo.TotalHours}:{tempo.Minutes:D2}:{tempo.Seconds:D2}"
                : $"{tempo.Minutes}:{tempo.Seconds:D2}";
        }
    }

    private string TamanhoTexto
    {
        get
        {
            var bytes = (double)(Video?.SizeBytes ?? 0);

            if (bytes <= 0)
                return "—";

            string[] unidades = ["B", "KiB", "MiB", "GiB", "TiB"];
            var indice = 0;

            while (bytes >= 1024 && indice < unidades.Length - 1)
            {
                bytes /= 1024;
                indice++;
            }

            return $"{bytes:0.#} {unidades[indice]}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Video = await Admin.FindAsync(VideoId, Http.RequestAborted);

        if (Video is null)
        {
            Navegacao.NotFound();
            return;
        }

        QuantasLegendas = (await Legendas.ListAsync(VideoId, Http.RequestAborted)).Count;

        Notas = await Avaliacoes.SummaryAsync(VideoId, Http.RequestAborted);

        var capitulos = await Sumarios.ListAsync(VideoId, Http.RequestAborted);
        LinhasDoSumario = capitulos.Count > 0
            ? [.. capitulos.Select(c => (OpenTube.Domain.Media.VideoTimestamps.Format(TimeSpan.FromSeconds(c.StartSeconds)), c.Title))]
            : [("0:00", string.Empty)];
    }
}
