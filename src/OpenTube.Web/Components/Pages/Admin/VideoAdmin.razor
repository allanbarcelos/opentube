@page "/admin/videos/{videoId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject AdminVideoService Admin
@inject OpenTube.Infrastructure.Services.CaptionService Legendas
@inject ShareLinkFlash Links
@inject NavigationManager Navegacao

<PageTitle>@(Video?.Title ?? T["Video"]) — @T["Administration"]</PageTitle>

<div class="container py-4">
    @if (Video is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="@T["Breadcrumb"]">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Video.Title</li>
            </ol>
        </nav>

        @if (Salvo)
        {
            <div class="alert alert-success" role="status">@T["Changes saved."]</div>
        }
        @if (Enfileirado)
        {
            <div class="alert alert-success" role="status">@T["The video is back in the processing queue."]</div>
        }
        @if (Restaurado)
        {
            <div class="alert alert-success" role="status">@T["Video restored. It is still private."]</div>
        }
        @if (Convidados > 0)
        {
            <div class="alert alert-success" role="status">
                @T.Format(Convidados == 1 ? "{0} invite sent" : "{0} invites sent", Convidados)
            </div>
        }
        @if (DominioLiberado)
        {
            <div class="alert alert-success" role="status">@T["Domain granted."]</div>
        }
        @if (Revogado)
        {
            <div class="alert alert-success" role="status">@T["Access revoked."]</div>
        }
        @if (LegendaEnviada)
        {
            <div class="alert alert-success" role="status">@T["Caption uploaded."]</div>
        }
        @if (Transcrevendo)
        {
            <div class="alert alert-success" role="status">
                @T["Transcription is queued. The caption shows up here when it finishes."]
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(LinkCriado))
        {
            <div class="alert alert-warning">
                <p class="mb-2"><strong>@T["Link created."]</strong> @T["Copy it now: it will not be shown again."]</p>
                <input class="form-control font-monospace" value="@LinkCriado" readonly
                       onclick="this.select()" aria-label="@T["Share link address"]" />
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="alert alert-danger" role="alert">@Erro</div>
        }
        @if (Video.IsDeleted)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>@T["This video is deleted and is hidden from everyone."]</span>
                <form method="post" action="/admin/videos/@Video.Id/restore">
                    <AntiforgeryToken />
                    <button class="btn btn-sm btn-outline-dark" type="submit">@T["Restore"]</button>
                </form>
            </div>
        }

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link @(MostrarAudiencia ? "" : "active")" href="/admin/videos/@Video.Id">@T["Configuration"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(MostrarAudiencia ? "active" : "")" href="/admin/videos/@Video.Id?tab=audience">@T["Audience"]</a>
            </li>
        </ul>

        @if (MostrarAudiencia)
        {
            <PainelDeAudiencia VideoId="Video.Id" />
        }
        else
        {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header">@T["Video details"]</div>
                    <div class="card-body">
                        <form method="post" action="/admin/videos/@Video.Id/save">
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label" for="titulo">@T["Title"]</label>
                                <input class="form-control" id="titulo" name="titulo" value="@Video.Title"
                                       maxlength="300" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="descricao">@T["Description"]</label>
                                <textarea class="form-control" id="descricao" name="descricao" rows="4"
                                          maxlength="10000">@Video.Description</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="etiquetas">@T["Tags"]</label>
                                <input class="form-control" id="etiquetas" name="etiquetas"
                                       value="@string.Join(", ", Video.Tags)" />
                                <div class="form-text">@T["Separate with commas. They are included in search."]</div>
                            </div>

                            <fieldset class="mb-3">
                                <legend class="form-label">@T["Visibility"]</legend>

                                @foreach (var opcao in Opcoes)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="visibilidade"
                                               id="visibilidade-@((int)opcao.Valor)" value="@((int)opcao.Valor)"
                                               checked="@(Video.Visibility == opcao.Valor)"
                                               disabled="@(!Video.IsPlayable && opcao.Valor != VideoVisibility.Private)" />
                                        <label class="form-check-label" for="visibilidade-@((int)opcao.Valor)">
                                            <strong>@opcao.Rotulo</strong>
                                            <span class="d-block small text-body-secondary">@opcao.Explicacao</span>
                                        </label>
                                    </div>
                                }

                                @if (!Video.IsPlayable)
                                {
                                    <div class="form-text">
                                        @T["Only a ready video can stop being private."]
                                    </div>
                                }
                            </fieldset>

                            <button class="btn btn-primary" type="submit">@T["Save"]</button>
                            @if (Video.IsPlayable)
                            {
                                <a class="btn btn-outline-secondary ms-2" href="/watch/@Video.Slug">@T["View the video page"]</a>
                            }
                        </form>
                    </div>
                </div>

                <PainelDeAcessos TargetType="GrantTargetType.Video" TargetId="Video.Id" />
            </div>

            <div class="col-lg-5">
                <div class="card mb-3">
                    <div class="card-header">@T["Processing"]</div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["State"]</span><span class="badge @EstadoClasse">@EstadoTexto</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Duration"]</span><span>@(Video.IsPlayable ? DuracaoTexto : "—")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Resolution"]</span>
                            <span>@(Video.Width > 0 ? $"{Video.Width}×{Video.Height}" : "—")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Original size"]</span><span>@TamanhoTexto</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@T["Address"]</span><code class="small">/watch/@Video.Slug</code>
                        </li>
                    </ul>
                    <div class="card-body">
                        <form method="post" action="/admin/videos/@Video.Id/reprocess">
                            <AntiforgeryToken />
                            <button class="btn btn-outline-secondary w-100" type="submit">
                                @T["Reprocess from the original"]
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">@T["Captions"]</div>

                    @if (ListaDeLegendas.Count == 0)
                    {
                        <div class="card-body text-body-secondary small">
                            @T["No captions yet. Upload a file or generate one from the speech."]
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var legenda in ListaDeLegendas)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>
                                        @legenda.Label
                                        <span class="d-block small text-body-secondary">@legenda.Language</span>
                                    </span>
                                    <form method="post" action="/admin/videos/@Video.Id/captions/@legenda.Id/delete">
                                        <AntiforgeryToken />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@T["Remove"]</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }

                    <div class="card-body border-top">
                        <form method="post" action="/admin/videos/@Video.Id/captions" enctype="multipart/form-data">
                            <AntiforgeryToken />

                            <div class="mb-2">
                                <label class="form-label small" for="arquivo-legenda">@T["WebVTT file"]</label>
                                <input class="form-control form-control-sm" id="arquivo-legenda" name="arquivo"
                                       type="file" accept=".vtt,text/vtt" required />
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small" for="idioma">@T["Language"]</label>
                                    <input class="form-control form-control-sm" id="idioma" name="idioma"
                                           value="pt-BR" maxlength="20" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small" for="rotulo">@T["Label"]</label>
                                    <input class="form-control form-control-sm" id="rotulo" name="rotulo"
                                           placeholder="@T["English"]" maxlength="120" />
                                </div>
                            </div>

                            <button class="btn btn-sm btn-outline-primary w-100" type="submit">@T["Upload caption"]</button>
                        </form>

                        <form method="post" action="/admin/videos/@Video.Id/captions/transcribe" class="mt-2">
                            <AntiforgeryToken />
                            <button class="btn btn-sm btn-outline-secondary w-100" type="submit">
                                @T["Generate from the speech"]
                            </button>
                        </form>
                    </div>
                </div>

                @if (!Video.IsDeleted)
                {
                    <div class="card border-danger">
                        <div class="card-header text-danger">@T["Delete"]</div>
                        <div class="card-body">
                            <p class="small text-body-secondary">
                                @T["The video leaves the library and access immediately. The record stays so the viewing history still makes sense."]
                            </p>
                            <form method="post" action="/admin/videos/@Video.Id/delete">
                                <AntiforgeryToken />
                                <button class="btn btn-outline-danger w-100" type="submit">@T["Delete video"]</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
        }
    }
</div>

@code {
    private (VideoVisibility Valor, string Rotulo, string Explicacao)[] Opcoes =>
    [
        (VideoVisibility.Private, T["Private"], T["Administrators only."]),
        (VideoVisibility.Public, T["Public"], T["Any visitor, without signing in."]),
        (VideoVisibility.Restricted, T["Restricted"], T["Only people with an access grant."])
    ];

    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid VideoId { get; set; }

    [SupplyParameterFromQuery(Name = "salvo")]
    private string? SalvoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "enfileirado")]
    private string? EnfileiradoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "restaurado")]
    private string? RestauradoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    [SupplyParameterFromQuery(Name = "convidados")]
    private int? ConvidadosBruto { get; set; }

    [SupplyParameterFromQuery(Name = "dominio")]
    private string? DominioBruto { get; set; }

    [SupplyParameterFromQuery(Name = "revogado")]
    private string? RevogadoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    private string? LinkBruto { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Aba { get; set; }

    [SupplyParameterFromQuery(Name = "legenda")]
    private string? LegendaBruta { get; set; }

    [SupplyParameterFromQuery(Name = "transcrevendo")]
    private string? TranscrevendoBruto { get; set; }

    private bool LegendaEnviada => LegendaBruta == "1";
    private bool Transcrevendo => TranscrevendoBruto == "1";

    private bool MostrarAudiencia => Aba == "audience";

    private int Convidados => ConvidadosBruto ?? 0;
    private bool DominioLiberado => DominioBruto == "1";
    private bool Revogado => RevogadoBruto == "1";
    private string? LinkCriado;

    private bool Salvo => SalvoBruto == "1";
    private bool Enfileirado => EnfileiradoBruto == "1";
    private bool Restaurado => RestauradoBruto == "1";

    private Video? Video;

    private IReadOnlyList<VideoAsset> ListaDeLegendas = [];

    private string EstadoTexto => Video?.Status switch
    {
        VideoStatus.Draft => T["Waiting for the file"],
        VideoStatus.Uploaded => T["Queued"],
        VideoStatus.Processing => T["Processing"],
        VideoStatus.Ready => T["Ready"],
        _ => T["Failed"]
    };

    private string EstadoClasse => Video?.Status switch
    {
        VideoStatus.Ready => "text-bg-success",
        VideoStatus.Failed => "text-bg-danger",
        VideoStatus.Processing => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private string DuracaoTexto
    {
        get
        {
            var tempo = TimeSpan.FromSeconds(Video?.DurationSeconds ?? 0);

            return tempo.TotalHours >= 1
                ? $"{(int)tempo.TotalHours}:{tempo.Minutes:D2}:{tempo.Seconds:D2}"
                : $"{tempo.Minutes}:{tempo.Seconds:D2}";
        }
    }

    private string TamanhoTexto
    {
        get
        {
            var bytes = (double)(Video?.SizeBytes ?? 0);

            if (bytes <= 0)
                return "—";

            string[] unidades = ["B", "KiB", "MiB", "GiB", "TiB"];
            var indice = 0;

            while (bytes >= 1024 && indice < unidades.Length - 1)
            {
                bytes /= 1024;
                indice++;
            }

            return $"{bytes:0.#} {unidades[indice]}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // O endereço do link é recuperado do servidor e descartado: só aparece uma vez.
        LinkCriado = Links.Take(LinkBruto);

        Video = await Admin.FindAsync(VideoId, Http.RequestAborted);

        if (Video is null)
        {
            Navegacao.NotFound();
            return;
        }

        ListaDeLegendas = await Legendas.ListAsync(VideoId, Http.RequestAborted);
    }
}
