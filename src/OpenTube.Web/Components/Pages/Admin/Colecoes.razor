@page "/admin/collections"
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject CollectionService Servico

<PageTitle>@T["Collections — Administration"]</PageTitle>

<div class="container py-4">
    <nav aria-label="@T["Breadcrumb"]">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@T["Collections"]</li>
        </ol>
    </nav>

    @if (Excluida)
    {
        <div class="alert alert-success" role="status">@T["Collection deleted."]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="alert alert-danger" role="alert">@Erro</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">@T["Collections"]</div>

                @if (Lista.Count == 0)
                {
                    <div class="card-body text-center text-body-secondary py-5">
                        @T["No collections yet. Create the first one beside this."]
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var colecao in Lista)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                                <div>
                                    <a href="/admin/collections/@colecao.Id" class="text-decoration-none fw-semibold">
                                        @colecao.Name
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(colecao.Description))
                                    {
                                        <span class="d-block small text-body-secondary">@colecao.Description</span>
                                    }
                                </div>
                                <div class="text-nowrap">
                                    <span class="badge text-bg-secondary">@T.Format(colecao.VideoCount == 1 ? "{0} video" : "{0} videos", colecao.VideoCount)</span>
                                    <span class="badge text-bg-light">@T.Format("{0} grants", colecao.GrantCount)</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">@T["New collection"]</div>
                <div class="card-body">
                    <form method="post" action="/admin/collections/create">
                        <AntiforgeryToken />

                        <div class="mb-3">
                            <label class="form-label" for="nome">@T["Name"]</label>
                            <input class="form-control" id="nome" name="nome" maxlength="200" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="descricao">@T["Description"]</label>
                            <textarea class="form-control" id="descricao" name="descricao" rows="2"
                                      maxlength="2000"></textarea>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">@T["Create"]</button>
                    </form>
                </div>
            </div>

            <div class="alert alert-light border mt-3 small mb-0">
                @T["Granting access to a collection also covers videos added to it later."]
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "excluida")]
    private string? ExcluidaBruta { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Excluida => ExcluidaBruta == "1";

    private IReadOnlyList<CollectionSummary> Lista = [];

    protected override async Task OnInitializedAsync() =>
        Lista = await Servico.ListAsync(cancellationToken: Http.RequestAborted);
}
