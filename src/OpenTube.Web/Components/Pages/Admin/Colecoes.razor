@page "/admin/colecoes"
@using OpenTube.Infrastructure.Services
@attribute [Authorize(Policy = Policies.Administrator)]
@inject CollectionService Servico

<PageTitle>Coleções — Administração</PageTitle>

<div class="container py-4">
    <nav aria-label="Trilha de navegação">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">Administração</a></li>
            <li class="breadcrumb-item active" aria-current="page">Coleções</li>
        </ol>
    </nav>

    @if (Excluida)
    {
        <div class="alert alert-success" role="status">Coleção excluída.</div>
    }
    @if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="alert alert-danger" role="alert">@Erro</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">Coleções</div>

                @if (Lista.Count == 0)
                {
                    <div class="card-body text-center text-body-secondary py-5">
                        Nenhuma coleção ainda. Crie a primeira ao lado.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var colecao in Lista)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                                <div>
                                    <a href="/admin/colecoes/@colecao.Id" class="text-decoration-none fw-semibold">
                                        @colecao.Name
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(colecao.Description))
                                    {
                                        <span class="d-block small text-body-secondary">@colecao.Description</span>
                                    }
                                </div>
                                <div class="text-nowrap">
                                    <span class="badge text-bg-secondary">@colecao.VideoCount vídeos</span>
                                    <span class="badge text-bg-light">@colecao.GrantCount acessos</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">Nova coleção</div>
                <div class="card-body">
                    <form method="post" action="/admin/colecoes/criar">
                        <AntiforgeryToken />

                        <div class="mb-3">
                            <label class="form-label" for="nome">Nome</label>
                            <input class="form-control" id="nome" name="nome" maxlength="200" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="descricao">Descrição</label>
                            <textarea class="form-control" id="descricao" name="descricao" rows="2"
                                      maxlength="2000"></textarea>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">Criar</button>
                    </form>
                </div>
            </div>

            <div class="alert alert-light border mt-3 small mb-0">
                Conceder acesso a uma coleção alcança também os vídeos que entrarem nela depois.
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "excluida")]
    private string? ExcluidaBruta { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Excluida => ExcluidaBruta == "1";

    private IReadOnlyList<CollectionSummary> Lista = [];

    protected override async Task OnInitializedAsync() =>
        Lista = await Servico.ListAsync(cancellationToken: Http.RequestAborted);
}
