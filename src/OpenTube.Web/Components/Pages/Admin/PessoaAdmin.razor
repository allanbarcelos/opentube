@page "/admin/people/{userId:guid}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Access
@using OpenTube.Infrastructure.Analytics
@using OpenTube.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = Policies.Administrator)]
@inject AnalyticsQueries Consultas
@inject GrantQueries Concessoes
@inject OpenTubeDbContext Db
@inject NavigationManager Navegacao

<PageTitle>@(Pessoa?.Email ?? T["Person"]) — @T["Administration"]</PageTitle>

<div class="container py-4">
    @if (Pessoa is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <nav aria-label="@T["Breadcrumb"]">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">@T["Administration"]</a></li>
                <li class="breadcrumb-item"><a href="/admin/people">@T["People"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Pessoa.Email</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h1 class="h4 mb-0">
                @Pessoa.Email
                @if (Pessoa.IsAdmin)
                {
                    <span class="badge text-bg-primary align-middle ms-1">@T["Administrator"]</span>
                }
                @if (!Pessoa.IsActive)
                {
                    <span class="badge text-bg-secondary align-middle ms-1">@T["Disabled"]</span>
                }
            </h1>

            @if (Atividade.Count > 0)
            {
                <a class="btn btn-outline-secondary btn-sm" href="/admin/export/people/@UserId/activity.csv">
                    @T["Export CSV"]
                </a>
            }
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">@T["What they watched"]</div>

                    @if (Atividade.Count == 0)
                    {
                        <div class="card-body text-center text-body-secondary py-5">
                            @T["This person has not watched anything yet."]
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@T["Video"]</th>
                                        <th scope="col">@T["When"]</th>
                                        <th scope="col">@T["Watched"]</th>
                                        <th scope="col">@T["Device"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Atividade)
                                    {
                                        <tr>
                                            <td>
                                                <a href="/admin/videos/@item.VideoId" class="text-decoration-none">@item.Title</a>
                                            </td>
                                            <td class="small">@item.At.ToLocalTime().ToString("g")</td>
                                            <td>
                                                @((item.Coverage * 100).ToString("0")) %
                                                @if (item.Completed)
                                                {
                                                    <span class="badge text-bg-success ms-1">@T["to the end"]</span>
                                                }
                                            </td>
                                            <td class="small">@item.Device</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">@T["Grants"]</div>

                    @if (Acessos.Count == 0)
                    {
                        <div class="card-body text-body-secondary small">
                            @T["No individual grant. Access may come from the email domain."]
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var concessao in Acessos)
                            {
                                <li class="list-group-item d-flex justify-content-between small">
                                    <span>@GrantLabels.Target(concessao.TargetType)</span>
                                    <span class="text-body-secondary">
                                        @(concessao.IsRevoked ? T["Revoked"] : T["in effect"])
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public Guid UserId { get; set; }

    private User? Pessoa;

    private IReadOnlyList<ViewerActivity> Atividade = [];

    private IReadOnlyList<AccessGrant> Acessos = [];

    protected override async Task OnInitializedAsync()
    {
        Pessoa = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == UserId, Http.RequestAborted);

        if (Pessoa is null)
        {
            Navegacao.NotFound();
            return;
        }

        Atividade = await Consultas.ViewerTimelineAsync(UserId, cancellationToken: Http.RequestAborted);
        Acessos = await Concessoes.ListForEmailAsync(Pessoa.Email, Http.RequestAborted);
    }
}
