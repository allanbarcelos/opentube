@page "/watch/{slug}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Playback
@using OpenTube.Domain.Media
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores
@inject OpenTube.Infrastructure.Branding.WatermarkService Marcas
@inject OpenTube.Infrastructure.Services.CaptionService Legendas
@inject OpenTube.Infrastructure.Services.VideoChapterService Sumarios
@inject OpenTube.Infrastructure.Services.VideoRatingService Avaliacoes
@inject OpenTube.Infrastructure.Services.VideoFavoriteService Favoritos
@inject OpenTube.Infrastructure.Services.CollectionNoticeService Avisos
@inject Microsoft.Extensions.Options.IOptions<OpenTube.Infrastructure.Options.SecurityOptions> Seguranca
@inject NavigationManager Navegacao

<PageTitle>@(Video?.Title ?? T["Video not found"]) — OpenTube</PageTitle>

<div class="container py-4">
    @if (Video is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else if (!Video.IsPlayable)
    {
        <h1 class="h4">@Video.Title</h1>
        <div class="alert alert-info">
            @T["This video is still being processed. Come back in a few minutes."]
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @* Proteção básica: não impede gravação de tela (nada no navegador impede), mas tira
                   os atalhos de download e mantém a marca d'água na imagem — por cima do vídeo na
                   página e na tela cheia do contêiner, como legenda na tela cheia nativa e no
                   Picture-in-Picture. Quem grava a tela grava junto quem estava vendo. *@
                <div class="player-shell rounded overflow-hidden shadow-sm position-relative"
                     data-fullscreen-label="@T["Full screen"]" data-logo-canto="@((int?)Logo?.Position)"
                     data-controles data-rotulos="@Rotulos" data-capitulos="@CapitulosDoPlayer">
                    <video id="player-video" controls playsinline preload="metadata"
                           controlslist="nodownload nofullscreen noremoteplayback"
                           disableremoteplayback x-webkit-airplay="deny"
                           poster="/api/videos/@Video.Id/thumbnail" crossorigin="use-credentials"
                           data-manifest="/api/videos/@Video.Id/master.m3u8" data-video-id="@Video.Id"
                           data-proximo="@Proximo"
                           data-unsupported="@T["This browser cannot play the video."]">
                        @foreach (var legenda in ListaDeLegendas)
                        {
                            <track kind="subtitles" src="/api/videos/@Video.Id/captions/@(legenda.Id).vtt"
                                   srclang="@legenda.Language" label="@(legenda.Label ?? legenda.Language)" />
                        }
                    </video>

                    @* Marca do acervo, definida na administração: a mesma imagem sobre todos os vídeos. *@
                    @if (Logo is not null)
                    {
                        <MarcaDoAcervo Marca="Logo" />
                    }

                    @if (!string.IsNullOrWhiteSpace(MarcaDagua))
                    {
                        @* O mosaico cobre o quadro inteiro, então recortar a borda não o remove;
                           a etiqueta que muda de canto leva também a data e a hora. *@
                        <div class="marca-dagua-mosaico" id="marca-dagua-mosaico" data-texto="@MarcaDagua" aria-hidden="true"></div>
                        <span class="marca-dagua" id="marca-dagua" data-texto="@MarcaDagua">@MarcaDagua</span>
                    }
                </div>

                <div class="d-flex align-items-center gap-2 mt-3 mb-1">
                    <h1 class="h4 mb-0">@Video.Title</h1>
                    @if (Espectador.IsAuthenticated)
                    {
                        <EstrelaDoVideo Slug="@Video.Slug" Favorito="VideoFavorito" Destino="@DestinoDoVideo" />
                    }
                </div>
                <p class="text-body-secondary small mb-3">
                    @DuracaoTexto
                    @if (Video.PublishedAt is { } publicado)
                    {
                        <span class="mx-1">&middot;</span>
                        <span>@publicado.ToLocalTime().ToString("d")</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(Video.Description))
                {
                    <div class="card">
                        <div class="card-body">
                            <p class="card-text mb-0" style="white-space: pre-wrap">@Video.Description</p>
                        </div>
                    </div>
                }

                <AvaliacaoDoVideo VideoId="Video.Id" Destino="@($"/watch/{Video.Slug}")"
                                  Autenticado="Espectador.IsAuthenticated" Minha="MinhaNota" />

                <ConversasDoVideo VideoId="Video.Id" Destino="@($"/watch/{Video.Slug}")"
                                  Duracao="@(Video.DurationSeconds is { } d ? TimeSpan.FromSeconds(d) : null)" />
            </div>

            <div class="col-lg-4">
                @if (Playlist is not null)
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2 min-w-0">
                                <a class="text-decoration-none text-truncate" href="/collections/@Playlist.Slug">@Playlist.Name</a>
                                @if (Espectador.IsAuthenticated)
                                {
                                    <EstrelaDaColecao Slug="@Playlist.Slug" Favorita="Playlist.IsFavorite" Destino="@DestinoDaPlaylist" />
                                }
                            </div>
                            <div class="form-check form-switch mb-0 flex-shrink-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="autoplay-colecao"
                                       data-autoplay checked />
                                <label class="form-check-label" for="autoplay-colecao">@T["Autoplay"]</label>
                            </div>
                        </div>
                        <ListaDaPlaylist Videos="Playlist.Videos" CollectionSlug="@Playlist.Slug" Atual="Video.Id"
                                         Classe="list-group-flush playlist-lista" />
                    </div>
                }

                @if (Capitulos.Count > 0)
                {
                    <div class="card mb-3" data-sumario-lista>
                        <div class="card-header">@T["Chapters"]</div>
                        <div class="list-group list-group-flush">
                            @for (var i = 0; i < Capitulos.Count; i++)
                            {
                                var capitulo = Capitulos[i];
                                <a class="list-group-item list-group-item-action d-flex gap-3 sumario-item"
                                   href="@EnderecoDoCapitulo(capitulo.StartSeconds)" data-instante="@capitulo.StartSeconds"
                                   data-capitulo="@i">
                                    <span class="font-monospace small text-body-secondary pt-1">@VideoTimestamps.Format(TimeSpan.FromSeconds(capitulo.StartSeconds))</span>
                                    <span>@capitulo.Title</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (Video.Tags.Count > 0)
                {
                    <h2 class="h6">@T["Tags"]</h2>
                    <p>
                        @foreach (var etiqueta in Video.Tags)
                        {
                            <a class="badge text-bg-light text-decoration-none me-1"
                               href="/?q=@Uri.EscapeDataString(etiqueta)">@etiqueta</a>
                        }
                    </p>
                }

                <div class="alert alert-light border small mb-0">
                    @T["Access to this video is recorded, including how much of it was watched."]
                </div>
            </div>
        </div>

        @* Sem <script> aqui: a navegação aprimorada do Blazor não executa scripts da página
           nova. O player.js, carregado no layout, monta o vídeo a partir dos atributos data-. *@
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "collection")]
    private string? ColecaoSlug { get; set; }

    private Viewer Espectador = Viewer.Anonymous;

    private Video? Video;

    private PlaylistListing? Playlist;

    /// <summary>Endereço desta reprodução, para a estrela devolver a pessoa ao mesmo vídeo.</summary>
    private string DestinoDaPlaylist =>
        $"/watch/{Video!.Slug}?collection={Uri.EscapeDataString(Playlist!.Slug)}";

    /// <summary>A estrela do vídeo volta para esta reprodução, com a coleção quando ela está aberta.</summary>
    private string DestinoDoVideo => Playlist is null ? $"/watch/{Video!.Slug}" : DestinoDaPlaylist;

    private bool VideoFavorito;

    /// <summary>Próximo vídeo da playlist, com o pedido para começar sozinho.</summary>
    private string? Proximo
    {
        get
        {
            if (Video is null || Playlist is null)
                return null;

            var seguinte = Playlist.NextAfter(Video.Id);
            return seguinte is null
                ? null
                : $"/watch/{seguinte.Slug}?collection={Uri.EscapeDataString(Playlist.Slug)}&autoplay=1";
        }
    }

    /// <summary>
    /// Identificação exibida sobre o vídeo. Não impede a gravação de tela, mas identifica a
    /// origem de um vazamento e inibe o repasse casual.
    /// </summary>
    private string? MarcaDagua;

    private IReadOnlyList<OpenTube.Domain.Entities.VideoAsset> ListaDeLegendas = [];

    private IReadOnlyList<Chapter> Capitulos = [];

    private int? MinhaNota;

    /// <summary>Pedaços da barra de progresso; um trecho antes do primeiro capítulo fica sem título.</summary>
    private readonly List<(int Inicio, int Fim, string Titulo)> Segmentos = [];

    /// <summary>Capítulos para os controles do player (controles.js), em JSON.</summary>
    private string CapitulosDoPlayer => System.Text.Json.JsonSerializer.Serialize(
        Segmentos.Select(s => new { inicio = s.Inicio, fim = s.Fim, titulo = s.Titulo }));

    /// <summary>Textos dos controles do player, na língua da página.</summary>
    private string Rotulos => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["play"] = T["Play"],
        ["pause"] = T["Pause"],
        ["mute"] = T["Mute"],
        ["unmute"] = T["Unmute"],
        ["volume"] = T["Volume"],
        ["progress"] = T["Video progress"],
        ["chapters"] = T["Chapters"],
        ["captions"] = T["Captions"],
        ["off"] = T["Off"],
        ["settings"] = T["Settings"],
        ["speed"] = T["Playback speed"],
        ["normal"] = T["Normal"],
        ["quality"] = T["Quality"],
        ["auto"] = T["Auto"],
        ["pip"] = T["Picture in picture"],
        ["fullscreen"] = T["Full screen"],
        ["exitFullscreen"] = T["Exit full screen"],
    });

    private OpenTube.Infrastructure.Branding.WatermarkInfo? Logo;

    private string DuracaoTexto
    {
        get
        {
            var tempo = TimeSpan.FromSeconds(Video?.DurationSeconds ?? 0);

            return tempo.TotalHours >= 1
                ? $"{(int)tempo.TotalHours}:{tempo.Minutes:D2}:{tempo.Seconds:D2}"
                : $"{tempo.Minutes}:{tempo.Seconds:D2}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Espectador = await Espectadores.GetAsync(Http.RequestAborted);

        // Abrir a página é pedir uma reprodução nova: o bilhete de uma reprodução anterior não
        // pode mostrar o player a quem já esgotou as visualizações.
        Video = await Catalogo.FindBySlugAsync(Espectador.StartingNewView(), Slug, Http.RequestAborted);

        if (Video is not null)
        {
            // Abrir o vídeo é o clique que apaga o distintivo. A playlist já sai sem ele.
            if (Espectador.UserId is Guid usuario)
            {
                await Avisos.MarkSeenAsync(usuario, Video.Id, Http.RequestAborted);
                VideoFavorito = await Favoritos.IsFavoriteAsync(usuario, Video.Id, Http.RequestAborted);
            }

            var playlist = await Catalogo.PlaylistAsync(Espectador, ColecaoSlug, Http.RequestAborted);
            if (playlist is not null && playlist.Contains(Video.Id))
                Playlist = playlist;

            ListaDeLegendas = await Legendas.ListPlayableAsync(Video.Id, Http.RequestAborted);
            Capitulos = await Sumarios.ListAsync(Video.Id, Http.RequestAborted);
            MinhaNota = await Avaliacoes.GetMineAsync(Video.Id, Espectador, Http.RequestAborted);
            MontarSegmentos();
            Logo = await Marcas.GetInfoAsync(Http.RequestAborted);
        }

        // Quem entrou pelo link secreto não tem email: a marca leva o começo do identificador
        // da concessão, que a administração encontra na lista de acessos do vídeo. Vídeo
        // público visto por anônimo fica sem marca: não há de quem seria o vazamento.
        if (Seguranca.Value.WatermarkEnabled)
        {
            MarcaDagua = Espectador.IsAuthenticated
                ? Espectador.Email
                : Espectador.LinkGrantId is { } link ? $"link {link.ToString("n")[..8]}" : null;
        }

        // Vídeo inexistente e vídeo sem acesso respondem exatamente igual. A diferença entre
        // "não existe" e "existe mas não é para você" já seria informação sobre o acervo.
        if (Video is null)
            Navegacao.NotFound();
    }

    private string EnderecoDoCapitulo(int segundos)
    {
        var endereco = $"/watch/{Video!.Slug}?t={segundos}";
        return Playlist is null
            ? endereco
            : endereco + "&collection=" + Uri.EscapeDataString(Playlist.Slug);
    }

    private void MontarSegmentos()
    {
        Segmentos.Clear();
        var duracao = TimeSpan.FromSeconds(Video?.DurationSeconds ?? 0);
        if (Capitulos.Count == 0 || duracao <= TimeSpan.Zero)
            return;

        if (Capitulos[0].StartSeconds > 0)
            Segmentos.Add((0, Capitulos[0].StartSeconds, string.Empty));

        for (var i = 0; i < Capitulos.Count; i++)
        {
            var fim = VideoChapters.EndOf(Capitulos, i, duracao);
            Segmentos.Add((Capitulos[i].StartSeconds, fim, Capitulos[i].Title));
        }
    }
}
