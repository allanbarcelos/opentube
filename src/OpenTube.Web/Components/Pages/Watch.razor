@page "/watch/{slug}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Playback
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores
@inject OpenTube.Infrastructure.Branding.WatermarkService Marcas
@inject OpenTube.Infrastructure.Services.CaptionService Legendas
@inject Microsoft.Extensions.Options.IOptions<OpenTube.Infrastructure.Options.SecurityOptions> Seguranca
@inject NavigationManager Navegacao

<PageTitle>@(Video?.Title ?? T["Video not found"]) — OpenTube</PageTitle>

<div class="container py-4">
    @if (Video is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else if (!Video.IsPlayable)
    {
        <h1 class="h4">@Video.Title</h1>
        <div class="alert alert-info">
            @T["This video is still being processed. Come back in a few minutes."]
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @* Proteção básica: não impede gravação de tela (nada no navegador impede), mas tira
                   os atalhos de download e mantém a marca d'água na imagem — por cima do vídeo na
                   página e na tela cheia do contêiner, como legenda na tela cheia nativa e no
                   Picture-in-Picture. Quem grava a tela grava junto quem estava vendo. *@
                <div class="player-shell rounded overflow-hidden shadow-sm position-relative"
                     data-fullscreen-label="@T["Full screen"]" data-logo-canto="@((int?)Logo?.Position)">
                    <video id="player-video" controls playsinline preload="metadata"
                           controlslist="nodownload nofullscreen noremoteplayback"
                           disableremoteplayback x-webkit-airplay="deny"
                           poster="/api/videos/@Video.Id/thumbnail" crossorigin="use-credentials"
                           data-manifest="/api/videos/@Video.Id/master.m3u8" data-video-id="@Video.Id"
                           data-unsupported="@T["This browser cannot play the video."]">
                        @foreach (var legenda in ListaDeLegendas)
                        {
                            <track kind="subtitles" src="/api/videos/@Video.Id/captions/@(legenda.Id).vtt"
                                   srclang="@legenda.Language" label="@(legenda.Label ?? legenda.Language)" />
                        }
                    </video>

                    @* Marca do acervo, definida na administração: a mesma imagem sobre todos os vídeos. *@
                    @if (Logo is not null)
                    {
                        <MarcaDoAcervo Marca="Logo" />
                    }

                    @if (!string.IsNullOrWhiteSpace(MarcaDagua))
                    {
                        @* O mosaico cobre o quadro inteiro, então recortar a borda não o remove;
                           a etiqueta que muda de canto leva também a data e a hora. *@
                        <div class="marca-dagua-mosaico" id="marca-dagua-mosaico" data-texto="@MarcaDagua" aria-hidden="true"></div>
                        <span class="marca-dagua" id="marca-dagua" data-texto="@MarcaDagua">@MarcaDagua</span>
                    }
                </div>

                <h1 class="h4 mt-3 mb-1">@Video.Title</h1>
                <p class="text-body-secondary small mb-3">
                    @DuracaoTexto
                    @if (Video.PublishedAt is { } publicado)
                    {
                        <span class="mx-1">&middot;</span>
                        <span>@publicado.ToLocalTime().ToString("d")</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(Video.Description))
                {
                    <div class="card">
                        <div class="card-body">
                            <p class="card-text mb-0" style="white-space: pre-wrap">@Video.Description</p>
                        </div>
                    </div>
                }

                <ConversasDoVideo VideoId="Video.Id" Destino="@($"/watch/{Video.Slug}")" />
            </div>

            <div class="col-lg-4">
                @if (Video.Tags.Count > 0)
                {
                    <h2 class="h6">@T["Tags"]</h2>
                    <p>
                        @foreach (var etiqueta in Video.Tags)
                        {
                            <a class="badge text-bg-light text-decoration-none me-1"
                               href="/?q=@Uri.EscapeDataString(etiqueta)">@etiqueta</a>
                        }
                    </p>
                }

                <div class="alert alert-light border small mb-0">
                    @T["Access to this video is recorded, including how much of it was watched."]
                </div>
            </div>
        </div>

        @* Sem <script> aqui: a navegação aprimorada do Blazor não executa scripts da página
           nova. O player.js, carregado no layout, monta o vídeo a partir dos atributos data-. *@
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Viewer Espectador = Viewer.Anonymous;

    private Video? Video;

    /// <summary>
    /// Identificação exibida sobre o vídeo. Não impede a gravação de tela, mas identifica a
    /// origem de um vazamento e inibe o repasse casual.
    /// </summary>
    private string? MarcaDagua;

    private IReadOnlyList<OpenTube.Domain.Entities.VideoAsset> ListaDeLegendas = [];

    private OpenTube.Infrastructure.Branding.WatermarkInfo? Logo;

    private string DuracaoTexto
    {
        get
        {
            var tempo = TimeSpan.FromSeconds(Video?.DurationSeconds ?? 0);

            return tempo.TotalHours >= 1
                ? $"{(int)tempo.TotalHours}:{tempo.Minutes:D2}:{tempo.Seconds:D2}"
                : $"{tempo.Minutes}:{tempo.Seconds:D2}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Espectador = await Espectadores.GetAsync(Http.RequestAborted);

        // Abrir a página é pedir uma reprodução nova: o bilhete de uma reprodução anterior não
        // pode mostrar o player a quem já esgotou as visualizações.
        Video = await Catalogo.FindBySlugAsync(Espectador.StartingNewView(), Slug, Http.RequestAborted);

        if (Video is not null)
        {
            ListaDeLegendas = await Legendas.ListAsync(Video.Id, Http.RequestAborted);
            Logo = await Marcas.GetInfoAsync(Http.RequestAborted);
        }

        // Quem entrou pelo link secreto não tem email: a marca leva o começo do identificador
        // da concessão, que a administração encontra na lista de acessos do vídeo. Vídeo
        // público visto por anônimo fica sem marca: não há de quem seria o vazamento.
        if (Seguranca.Value.WatermarkEnabled)
        {
            MarcaDagua = Espectador.IsAuthenticated
                ? Espectador.Email
                : Espectador.LinkGrantId is { } link ? $"link {link.ToString("n")[..8]}" : null;
        }

        // Vídeo inexistente e vídeo sem acesso respondem exatamente igual. A diferença entre
        // "não existe" e "existe mas não é para você" já seria informação sobre o acervo.
        if (Video is null)
            Navegacao.NotFound();
    }
}
