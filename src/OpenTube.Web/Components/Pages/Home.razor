@page "/"
@using OpenTube.Infrastructure.Playback
@using OpenTube.Web.Endpoints
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores

<TituloDaPagina Pagina="@(string.IsNullOrWhiteSpace(Q) ? null : T.Format("Search: {0}", Q))" />

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(Q))
    {
        <h1 class="h4 mb-1">@T.Format("Results for “{0}”", Q)</h1>
        <p class="text-body-secondary">@T.Format(Busca.Total == 1 ? "{0} video found" : "{0} videos found", Busca.Total)</p>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
            <h1 class="h4 mb-0">@T["Videos"]</h1>
            <form method="post" action="/listing/grouping" class="form-check form-switch mb-0">
                <AntiforgeryToken />
                <input type="hidden" name="destino" value="@DestinoDaHome" />
                <input type="hidden" name="agrupar" value="@(Agrupar ? "0" : "1")" />
                <input class="form-check-input" type="checkbox" role="switch" id="agrupar-colecao"
                       checked="@Agrupar" data-enviar-ao-mudar />
                <label class="form-check-label" for="agrupar-colecao">@T["Group collections"]</label>
            </form>
        </div>
    }

    @if (Vazio)
    {
        <div class="alert alert-light border text-center py-5">
            @if (Buscando)
            {
                <p class="mb-1">@T["No videos match your search."]</p>
                <a href="/">@T["See all videos"]</a>
            }
            else if (Espectador.IsAuthenticated)
            {
                <p class="mb-0">@T["No videos available to you right now."]</p>
            }
            else
            {
                <p class="mb-1">@T["No public videos available."]</p>
                <a href="/sign-in">@T["Sign in to see what has been shared with you"]</a>
            }
        </div>
    }
    else if (Buscando)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3">
            @foreach (var video in Busca.Items)
            {
                <VideoCard Video="video" MostrarVisibilidade="Espectador.IsAdmin"
                           PodeFavoritar="Espectador.IsAuthenticated" Destino="@DestinoDaBusca" />
            }
        </div>

        <Paginacao Resultado="Busca" Termo="@Q" />
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3">
            @foreach (var item in Inicio.Items)
            {
                @if (item.Kind == HomeCardKind.Collection)
                {
                    <CollectionCard Card="item" PodeFavoritar="Espectador.IsAuthenticated" Destino="@DestinoDaHome" />
                }
                else
                {
                    <VideoCard Video="item.ToVideo()" MostrarVisibilidade="Espectador.IsAdmin"
                               PodeFavoritar="Espectador.IsAuthenticated" Destino="@DestinoDaHome" />
                }
            }
        </div>

        <Paginacao Resultado="Inicio" />
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Pagina { get; set; }

    private Viewer Espectador = Viewer.Anonymous;

    private PagedResult<VideoSummary> Busca = PagedResult<VideoSummary>.Empty(VideoCatalog.DefaultPageSize);

    private PagedResult<HomeCard> Inicio = PagedResult<HomeCard>.Empty(VideoCatalog.DefaultPageSize);

    private bool Buscando => !string.IsNullOrWhiteSpace(Q);

    /// <summary>Sem cookie, a listagem agrupa. "0" desliga e mostra cada vídeo sozinho.</summary>
    private bool Agrupar => Http.Request.Cookies[ListingPreferenceEndpoints.GroupingCookie] is not "0";

    private bool Vazio => Buscando ? Busca.Items.Count == 0 : Inicio.Items.Count == 0;

    private string DestinoDaHome => Pagina is > 1 ? $"/?page={Pagina}" : "/";

    private string DestinoDaBusca
    {
        get
        {
            var partes = new List<string>();
            if (!string.IsNullOrWhiteSpace(Q))
                partes.Add("q=" + Uri.EscapeDataString(Q));
            if (Pagina is > 1)
                partes.Add($"page={Pagina}");

            return partes.Count == 0 ? "/" : "/?" + string.Join('&', partes);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Espectador = await Espectadores.GetAsync(Http.RequestAborted);

        // A busca mostra o vídeo mesmo quando ele está numa coleção. Sem busca, e com o
        // agrupamento ligado, a coleção ocupa o lugar dos vídeos dela.
        if (Buscando)
            Busca = await Catalogo.BrowseAsync(Espectador, Q, Pagina ?? 1, cancellationToken: Http.RequestAborted);
        else
            Inicio = await Catalogo.HomeAsync(
                Espectador, Pagina ?? 1, groupCollections: Agrupar, cancellationToken: Http.RequestAborted);
    }
}
