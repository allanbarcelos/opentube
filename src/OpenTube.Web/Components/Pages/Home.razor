@page "/"
@using OpenTube.Infrastructure.Playback
@inject VideoCatalog Catalogo
@inject CurrentViewer Espectadores

<PageTitle>@(string.IsNullOrWhiteSpace(Q) ? "OpenTube" : T.Format("Search: {0} — OpenTube", Q))</PageTitle>

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(Q))
    {
        <h1 class="h4 mb-1">@T.Format("Results for “{0}”", Q)</h1>
        <p class="text-body-secondary">@T.Format(Resultado.Total == 1 ? "{0} video found" : "{0} videos found", Resultado.Total)</p>
    }
    else
    {
        <h1 class="h4 mb-3">@T["Videos"]</h1>
    }

    @if (Resultado.Items.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            @if (!string.IsNullOrWhiteSpace(Q))
            {
                <p class="mb-1">@T["No videos match your search."]</p>
                <a href="/">@T["See all videos"]</a>
            }
            else if (Espectador.IsAuthenticated)
            {
                <p class="mb-0">@T["No videos available to you right now."]</p>
            }
            else
            {
                <p class="mb-1">@T["No public videos available."]</p>
                <a href="/sign-in">@T["Sign in to see what has been shared with you"]</a>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3">
            @foreach (var video in Resultado.Items)
            {
                <VideoCard Video="video" MostrarVisibilidade="Espectador.IsAdmin" />
            }
        </div>

        <Paginacao Resultado="Resultado" Termo="Q" />
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Pagina { get; set; }

    private Viewer Espectador = Viewer.Anonymous;

    private PagedResult<VideoSummary> Resultado = PagedResult<VideoSummary>.Empty(VideoCatalog.DefaultPageSize);

    protected override async Task OnInitializedAsync()
    {
        Espectador = await Espectadores.GetAsync(Http.RequestAborted);
        Resultado = await Catalogo.BrowseAsync(Espectador, Q, Pagina ?? 1, cancellationToken: Http.RequestAborted);
    }
}
