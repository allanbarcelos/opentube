@page "/entry/{slug}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Domains
@inject DomainService Dominios
@inject NavigationManager Navegacao

<PageTitle>@T["Access — OpenTube"]</PageTitle>

<div class="container py-5">
    @if (Dominio is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h4 mb-1">@T.Format("Access for {0}", Dominio.Name)</h1>
                        <p class="text-body-secondary small">
                            @T.Format("Enter your email at {0}. We send a six-digit code; there is no password and no sign-up.", "@" + Dominio.Name)
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Erro))
                        {
                            <div class="alert alert-danger" role="alert">@Erro</div>
                        }

                        @if (Enviado)
                        {
                            <div class="alert alert-success" role="status">
                                @T["If this address has access, the code is on its way."]
                            </div>

                            <form method="post" action="/sign-in/verify">
                                <AntiforgeryToken />
                                <input type="hidden" name="email" value="@Email" />

                                <div class="mb-3">
                                    <label class="form-label" for="codigo">@T["Code you received"]</label>
                                    <input class="form-control codigo-acesso" id="codigo" name="codigo"
                                           inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                                           pattern="[0-9]{6}" required autofocus />
                                </div>

                                <button class="btn btn-primary w-100" type="submit">@T["Sign in"]</button>
                            </form>

                            <form method="post" action="/entry/@Slug/code" class="mt-3 text-center">
                                <AntiforgeryToken />
                                <input type="hidden" name="email" value="@Email" />
                                <button class="btn btn-link btn-sm" type="submit">@T["Send another code"]</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" action="/entry/@Slug/code">
                                <AntiforgeryToken />

                                <div class="mb-3">
                                    <label class="form-label" for="email">@T["Your email"]</label>
                                    <input class="form-control" id="email" name="email" type="email"
                                           value="@Email" autocomplete="email" required autofocus
                                           placeholder="nome@@@Dominio.Name" />
                                </div>

                                <button class="btn btn-primary w-100" type="submit">@T["Get a code"]</button>
                            </form>
                        }
                    </div>
                </div>

                <p class="text-center text-body-secondary small mt-3 mb-0">
                    @T["Access to this platform is recorded."]
                </p>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "enviado")]
    private string? EnviadoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Enviado => EnviadoBruto == "1" && !string.IsNullOrWhiteSpace(Email);

    private VerifiedDomain? Dominio;

    protected override async Task OnInitializedAsync()
    {
        Dominio = await Dominios.FindOpenEntryAsync(Slug, Http.RequestAborted);

        // Porta fechada e porta inexistente respondem igual: a diferença já diria quais
        // organizações têm acesso à plataforma.
        if (Dominio is null)
            Navegacao.NotFound();
    }
}
