@page "/d/{slug}"
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Domains
@inject DomainService Dominios
@inject NavigationManager Navegacao

<PageTitle>Acesso — OpenTube</PageTitle>

<div class="container py-5">
    @if (Dominio is null)
    {
        @* A navegação já foi desviada para a página de não encontrado. *@
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h4 mb-1">Acesso de @Dominio.Name</h1>
                        <p class="text-body-secondary small">
                            Informe o seu email <strong>@@@Dominio.Name</strong>. Enviamos um código de seis
                            dígitos; não há senha nem cadastro.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Erro))
                        {
                            <div class="alert alert-danger" role="alert">@Erro</div>
                        }

                        @if (Enviado)
                        {
                            <div class="alert alert-success" role="status">
                                Se este endereço tiver acesso, o código já está a caminho.
                            </div>

                            <form method="post" action="/entrar/verificar">
                                <AntiforgeryToken />
                                <input type="hidden" name="email" value="@Email" />

                                <div class="mb-3">
                                    <label class="form-label" for="codigo">Código recebido</label>
                                    <input class="form-control codigo-acesso" id="codigo" name="codigo"
                                           inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                                           pattern="[0-9]{6}" required autofocus />
                                </div>

                                <button class="btn btn-primary w-100" type="submit">Entrar</button>
                            </form>

                            <form method="post" action="/d/@Slug/codigo" class="mt-3 text-center">
                                <AntiforgeryToken />
                                <input type="hidden" name="email" value="@Email" />
                                <button class="btn btn-link btn-sm" type="submit">Enviar outro código</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" action="/d/@Slug/codigo">
                                <AntiforgeryToken />

                                <div class="mb-3">
                                    <label class="form-label" for="email">Seu email</label>
                                    <input class="form-control" id="email" name="email" type="email"
                                           value="@Email" autocomplete="email" required autofocus
                                           placeholder="nome@@@Dominio.Name" />
                                </div>

                                <button class="btn btn-primary w-100" type="submit">Receber código</button>
                            </form>
                        }
                    </div>
                </div>

                <p class="text-center text-body-secondary small mt-3 mb-0">
                    Os acessos a esta plataforma são registrados.
                </p>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "enviado")]
    private string? EnviadoBruto { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }

    private bool Enviado => EnviadoBruto == "1" && !string.IsNullOrWhiteSpace(Email);

    private VerifiedDomain? Dominio;

    protected override async Task OnInitializedAsync()
    {
        Dominio = await Dominios.FindOpenEntryAsync(Slug, Http.RequestAborted);

        // Porta fechada e porta inexistente respondem igual: a diferença já diria quais
        // organizações têm acesso à plataforma.
        if (Dominio is null)
            Navegacao.NotFound();
    }
}
