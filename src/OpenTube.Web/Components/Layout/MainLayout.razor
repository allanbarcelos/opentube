@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <NavMenu />

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="border-top bg-body py-3 mt-4">
        <div class="container rodape small text-body-secondary">
            @* Créditos: o autor e o projeto original. A licença MIT não obriga a mantê-los, mas o
               pedido está no NOTICE: quem usa o OpenTube, por favor, deixe os dois links. *@
            <span class="rodape-credito" data-credito="autor">
                @T["Powered by"]
                <a class="link-secondary" href="https://www.barcelos.dev" target="_blank" rel="noopener">Barcelos.Dev</a>
            </span>
            <span class="rodape-aviso">@T["Access to this platform is recorded."]</span>
            <a class="rodape-github link-secondary fs-5 lh-1" href="https://github.com/allanbarcelos/opentube"
               target="_blank" rel="noopener" data-credito="opentube"
               title="@T["OpenTube on GitHub"]" aria-label="@T["OpenTube on GitHub"]">
                <i class="bi bi-github" aria-hidden="true"></i>
            </a>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="alert alert-danger rounded-0 mb-0 position-fixed bottom-0 start-0 end-0 d-none">
    @T["An unexpected error occurred."]
    <a href="." class="alert-link">@T["Reload"]</a>
</div>
