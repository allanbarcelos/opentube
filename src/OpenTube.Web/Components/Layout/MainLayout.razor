@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <NavMenu />

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="border-top bg-body py-3 mt-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small text-body-secondary">
            @* Crédito ao projeto original. A licença MIT não obriga a mantê-lo, mas o pedido está
               no NOTICE: quem usa o OpenTube, por favor, deixe o link. *@
            <span data-credito="opentube">
                @T["Powered by"]
                <a class="link-secondary" href="https://github.com/allanbarcelos/opentube"
                   target="_blank" rel="noopener">OpenTube</a>
            </span>
            <span>@T["Access to this platform is recorded."]</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="alert alert-danger rounded-0 mb-0 position-fixed bottom-0 start-0 end-0 d-none">
    @T["An unexpected error occurred."]
    <a href="." class="alert-link">@T["Reload"]</a>
</div>
