@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <NavMenu />

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="border-top bg-body py-3 mt-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small text-body-secondary">
            <span>OpenTube</span>
            <span>Os acessos a esta plataforma são registrados.</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="alert alert-danger rounded-0 mb-0 position-fixed bottom-0 start-0 end-0 d-none">
    Ocorreu um erro inesperado.
    <a href="." class="alert-link">Recarregar</a>
</div>
