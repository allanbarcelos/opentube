@* Concessões de acesso de um vídeo ou de uma coleção: quem tem, por quanto tempo, e como conceder mais. *@
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Access
@inject GrantService Concessoes

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Quem tem acesso</span>
        <span class="badge text-bg-secondary">@Lista.Count(g => !g.IsRevoked) em vigor</span>
    </div>

    @if (Lista.Count == 0)
    {
        <div class="card-body text-center text-body-secondary py-4">
            Ninguém além dos administradores.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Quem</th>
                        <th scope="col">Validade</th>
                        <th scope="col">Usos</th>
                        <th scope="col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var concessao in Lista)
                    {
                        <tr class="@(concessao.IsRevoked ? "text-body-secondary" : "")">
                            <td>
                                <span class="badge @TipoClasse(concessao) me-1">@TipoTexto(concessao)</span>
                                @Sujeito(concessao)
                                @if (!string.IsNullOrWhiteSpace(concessao.Note))
                                {
                                    <span class="d-block small text-body-secondary">@concessao.Note</span>
                                }
                            </td>
                            <td class="small">@Validade(concessao)</td>
                            <td class="small">@Usos(concessao)</td>
                            <td class="text-end">
                                @if (concessao.IsRevoked)
                                {
                                    <form method="post" action="/admin/acessos/@concessao.Id/restaurar">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                                        <input type="hidden" name="alvoId" value="@TargetId" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Restaurar</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/admin/acessos/@concessao.Id/revogar">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                                        <input type="hidden" name="alvoId" value="@TargetId" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Revogar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="accordion" id="formas-de-conceder">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#conceder-pessoas" aria-expanded="true" aria-controls="conceder-pessoas">
                Convidar pessoas por email
            </button>
        </h2>
        <div class="accordion-collapse collapse show" id="conceder-pessoas" data-bs-parent="#formas-de-conceder">
            <div class="accordion-body">
                <form method="post" action="/admin/acessos/convidar">
                    <AntiforgeryToken />
                    <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                    <input type="hidden" name="alvoId" value="@TargetId" />

                    <div class="mb-3">
                        <label class="form-label" for="emails">Endereços</label>
                        <textarea class="form-control" id="emails" name="emails" rows="3" required
                                  placeholder="allan@barcelos.dev, outra@empresa.com"></textarea>
                        <div class="form-text">Separe por vírgula, ponto e vírgula ou quebra de linha.</div>
                    </div>

                    <ValidadeDaConcessao Prefixo="convite" />

                    <div class="mb-3">
                        <label class="form-label" for="nota-convite">Anotação</label>
                        <input class="form-control" id="nota-convite" name="nota" maxlength="500"
                               placeholder="Para lembrar o motivo da liberação" />
                    </div>

                    <button class="btn btn-primary" type="submit">Convidar e enviar email</button>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#conceder-dominio" aria-expanded="false" aria-controls="conceder-dominio">
                Liberar um domínio inteiro
            </button>
        </h2>
        <div class="accordion-collapse collapse" id="conceder-dominio" data-bs-parent="#formas-de-conceder">
            <div class="accordion-body">
                <form method="post" action="/admin/acessos/dominio">
                    <AntiforgeryToken />
                    <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                    <input type="hidden" name="alvoId" value="@TargetId" />

                    <div class="mb-3">
                        <label class="form-label" for="dominio">Domínio</label>
                        <input class="form-control" id="dominio" name="dominio" required placeholder="barcelos.dev" />
                        <div class="form-text">
                            Qualquer pessoa com email deste domínio poderá assistir, depois de confirmar o
                            endereço pelo código.
                        </div>
                    </div>

                    <ValidadeDaConcessao Prefixo="dominio" />

                    <div class="mb-3">
                        <label class="form-label" for="nota-dominio">Anotação</label>
                        <input class="form-control" id="nota-dominio" name="nota" maxlength="500" />
                    </div>

                    <button class="btn btn-primary" type="submit">Liberar domínio</button>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#conceder-link" aria-expanded="false" aria-controls="conceder-link">
                Criar link secreto
            </button>
        </h2>
        <div class="accordion-collapse collapse" id="conceder-link" data-bs-parent="#formas-de-conceder">
            <div class="accordion-body">
                <form method="post" action="/admin/acessos/link">
                    <AntiforgeryToken />
                    <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                    <input type="hidden" name="alvoId" value="@TargetId" />

                    <ValidadeDaConcessao Prefixo="link" />

                    <div class="mb-3">
                        <label class="form-label" for="limite">Limite de visualizações</label>
                        <input class="form-control" id="limite" name="limiteDeVisualizacoes" type="number" min="1"
                               placeholder="sem limite" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="nota-link">Anotação</label>
                        <input class="form-control" id="nota-link" name="nota" maxlength="500" />
                    </div>

                    <div class="alert alert-warning small">
                        Quem tiver o endereço assiste sem se identificar. Ele é exibido uma única vez.
                    </div>

                    <button class="btn btn-primary" type="submit">Criar link</button>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter, EditorRequired]
    public GrantTargetType TargetType { get; set; }

    [Parameter]
    public Guid? TargetId { get; set; }

    private IReadOnlyList<AccessGrant> Lista = [];

    protected override async Task OnInitializedAsync() =>
        Lista = await Concessoes.ListForTargetAsync(TargetType, TargetId, Http.RequestAborted);

    private static string TipoTexto(AccessGrant concessao) => concessao.SubjectType switch
    {
        GrantSubjectType.User => "Pessoa",
        GrantSubjectType.Domain => "Domínio",
        GrantSubjectType.Link => "Link",
        _ => "Público"
    };

    private static string TipoClasse(AccessGrant concessao) => concessao.SubjectType switch
    {
        GrantSubjectType.User => "text-bg-primary",
        GrantSubjectType.Domain => "text-bg-info",
        GrantSubjectType.Link => "text-bg-warning",
        _ => "text-bg-success"
    };

    private static string Sujeito(AccessGrant concessao) => concessao.SubjectType switch
    {
        GrantSubjectType.Link => "link secreto",
        GrantSubjectType.Public => "qualquer visitante",
        _ => concessao.SubjectValue
    };

    private static string Validade(AccessGrant concessao)
    {
        if (concessao.IsRevoked)
            return "revogada";

        if (concessao.DurationAfterFirstUse is { } prazo)
        {
            return concessao.FirstUsedAt is null
                ? $"{(int)prazo.TotalDays} dias a partir do primeiro acesso"
                : $"até {concessao.EffectiveExpiry!.Value.ToLocalTime():dd/MM/yyyy}";
        }

        return concessao.ExpiresAt is { } fim ? $"até {fim.ToLocalTime():dd/MM/yyyy}" : "sem prazo";
    }

    private static string Usos(AccessGrant concessao) =>
        concessao.MaxViews is { } teto ? $"{concessao.ViewsUsed} de {teto}" : concessao.ViewsUsed.ToString();
}
