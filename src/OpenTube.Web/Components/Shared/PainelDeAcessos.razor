@* Concessões de acesso de um vídeo ou de uma coleção: quem tem, por quanto tempo, e como conceder mais. *@
@using OpenTube.Domain.Entities
@using OpenTube.Infrastructure.Access
@inject GrantService Concessoes

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@T["Who has access"]</span>
        <span class="badge text-bg-secondary">@T.Format("{0} active", Lista.Count(g => !g.IsRevoked))</span>
    </div>

    @if (Lista.Count == 0)
    {
        <div class="card-body text-center text-body-secondary py-4">
            @T["Nobody except administrators."]
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@T["Who"]</th>
                        <th scope="col">@T["Validity"]</th>
                        <th scope="col">@T["Uses"]</th>
                        <th scope="col"><span class="visually-hidden">@T["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var concessao in Lista)
                    {
                        <tr class="@(concessao.IsRevoked ? "text-body-secondary" : "")">
                            <td>
                                <span class="badge @TipoClasse(concessao) me-1">@TipoTexto(concessao)</span>
                                @Sujeito(concessao)
                                @if (!string.IsNullOrWhiteSpace(concessao.Note))
                                {
                                    <span class="d-block small text-body-secondary">@concessao.Note</span>
                                }
                            </td>
                            <td class="small">@Validade(concessao)</td>
                            <td class="small">@Usos(concessao)</td>
                            <td class="text-end">
                                @if (concessao.IsRevoked)
                                {
                                    <form method="post" action="/admin/access/@concessao.Id/restore">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                                        <input type="hidden" name="alvoId" value="@TargetId" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@T["Restore"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/admin/access/@concessao.Id/revoke">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                                        <input type="hidden" name="alvoId" value="@TargetId" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">@T["Revoke"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="accordion" id="formas-de-conceder">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#conceder-pessoas" aria-expanded="true" aria-controls="conceder-pessoas">
                @T["Invite people"]
            </button>
        </h2>
        <div class="accordion-collapse collapse show" id="conceder-pessoas" data-bs-parent="#formas-de-conceder">
            <div class="accordion-body">
                <form method="post" action="/admin/access/invite">
                    <AntiforgeryToken />
                    <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                    <input type="hidden" name="alvoId" value="@TargetId" />

                    <div class="mb-3">
                        <label class="form-label" for="emails">@T["Addresses"]</label>
                        <textarea class="form-control" id="emails" name="emails" rows="3" required
                                  placeholder="allan@barcelos.dev, outra@empresa.com"></textarea>
                        <div class="form-text">@T["Separate with a comma, semicolon, or line break."]</div>
                    </div>

                    <ValidadeDaConcessao Prefixo="convite" />

                    <div class="mb-3">
                        <label class="form-label" for="nota-convite">@T["Note"]</label>
                        <input class="form-control" id="nota-convite" name="nota" maxlength="500"
                               placeholder="@T["To remember why this was granted"]" />
                    </div>

                    <button class="btn btn-primary" type="submit">@T["Invite and send email"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#conceder-dominio" aria-expanded="false" aria-controls="conceder-dominio">
                @T["Grant a whole domain"]
            </button>
        </h2>
        <div class="accordion-collapse collapse" id="conceder-dominio" data-bs-parent="#formas-de-conceder">
            <div class="accordion-body">
                <form method="post" action="/admin/access/domain">
                    <AntiforgeryToken />
                    <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                    <input type="hidden" name="alvoId" value="@TargetId" />

                    <div class="mb-3">
                        <label class="form-label" for="dominio">@T["Domain"]</label>
                        <input class="form-control" id="dominio" name="dominio" required placeholder="barcelos.dev" />
                        <div class="form-text">
                            @T["Anyone with an email at this domain can watch, after confirming the address with the code."]
                        </div>
                    </div>

                    <ValidadeDaConcessao Prefixo="dominio" />

                    <div class="mb-3">
                        <label class="form-label" for="nota-dominio">@T["Note"]</label>
                        <input class="form-control" id="nota-dominio" name="nota" maxlength="500" />
                    </div>

                    <button class="btn btn-primary" type="submit">@T["Grant domain"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#conceder-link" aria-expanded="false" aria-controls="conceder-link">
                @T["Create a secret link"]
            </button>
        </h2>
        <div class="accordion-collapse collapse" id="conceder-link" data-bs-parent="#formas-de-conceder">
            <div class="accordion-body">
                <form method="post" action="/admin/access/link">
                    <AntiforgeryToken />
                    <input type="hidden" name="alvoTipo" value="@((int)TargetType)" />
                    <input type="hidden" name="alvoId" value="@TargetId" />

                    <ValidadeDaConcessao Prefixo="link" />

                    <div class="mb-3">
                        <label class="form-label" for="limite">@T["View limit"]</label>
                        <input class="form-control" id="limite" name="limiteDeVisualizacoes" type="number" min="1"
                               placeholder="@T["no limit"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="nota-link">@T["Note"]</label>
                        <input class="form-control" id="nota-link" name="nota" maxlength="500" />
                    </div>

                    <div class="alert alert-warning small">
                        @T["Anyone with the address can watch without identifying themselves. It is shown only once."]
                    </div>

                    <button class="btn btn-primary" type="submit">@T["Create link"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter, EditorRequired]
    public GrantTargetType TargetType { get; set; }

    [Parameter]
    public Guid? TargetId { get; set; }

    private IReadOnlyList<AccessGrant> Lista = [];

    protected override async Task OnInitializedAsync() =>
        Lista = await Concessoes.ListForTargetAsync(TargetType, TargetId, Http.RequestAborted);

    private string TipoTexto(AccessGrant concessao) => concessao.SubjectType switch
    {
        GrantSubjectType.User => T["Person"],
        GrantSubjectType.Domain => T["Domain"],
        GrantSubjectType.Link => T["Link"],
        _ => T["Public"]
    };

    private static string TipoClasse(AccessGrant concessao) => concessao.SubjectType switch
    {
        GrantSubjectType.User => "text-bg-primary",
        GrantSubjectType.Domain => "text-bg-info",
        GrantSubjectType.Link => "text-bg-warning",
        _ => "text-bg-success"
    };

    private string Sujeito(AccessGrant concessao) => concessao.SubjectType switch
    {
        GrantSubjectType.Link => T["secret link"],
        GrantSubjectType.Public => T["any visitor"],
        _ => concessao.SubjectValue
    };

    private string Validade(AccessGrant concessao)
    {
        if (concessao.IsRevoked)
            return T["Revoked"];

        if (concessao.DurationAfterFirstUse is { } prazo)
        {
            return concessao.FirstUsedAt is null
                ? T.Format("{0} days from the first visit", (int)prazo.TotalDays)
                : T.Format("until {0}", concessao.EffectiveExpiry!.Value.ToLocalTime().ToString("d"));
        }

        return concessao.ExpiresAt is { } fim
            ? T.Format("until {0}", fim.ToLocalTime().ToString("d"))
            : T["no end date"];
    }

    private string Usos(AccessGrant concessao) =>
        concessao.MaxViews is { } teto ? T.Format("{0} of {1}", concessao.ViewsUsed, teto) : concessao.ViewsUsed.ToString();
}
