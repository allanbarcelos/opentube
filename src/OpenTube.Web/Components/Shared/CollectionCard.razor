@* Cartão de coleção na página inicial. A miniatura é o título: a coleção não tem imagem própria. *@

<div class="col">
    <div class="card h-100 shadow-sm position-relative">
        @if (PodeFavoritar)
        {
            <EstrelaDaColecao Slug="@Card.Slug" Favorita="Card.IsFavorite" Destino="@Destino"
                              Classe="collection-favorite" SobreCapa="true" />
        }
        <a class="text-decoration-none text-body" href="/collections/@Card.Slug">
            <div class="card-img-top video-thumb collection-cover" aria-hidden="true">
                <span>@Card.Title</span>
            </div>
            <div class="card-body">
                <h2 class="h6 card-title video-card-title mb-1">@Card.Title</h2>
                <p class="card-text small text-body-secondary mb-0">
                    @T.Format(Card.VideoCount == 1 ? "{0} video" : "{0} videos", Card.VideoCount)
                </p>
            </div>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public HomeCard Card { get; set; } = default!;

    /// <summary>Quem entrou pode marcar a coleção. Visitante anônimo só vê o cartão.</summary>
    [Parameter]
    public bool PodeFavoritar { get; set; }

    /// <summary>Página atual, para a estrela devolver a pessoa ao mesmo lugar.</summary>
    [Parameter]
    public string Destino { get; set; } = "/";
}
