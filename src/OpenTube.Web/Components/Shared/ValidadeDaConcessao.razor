@* Validade comum a todos do convite. Cada opção tem o seu campo: escrever num deles escolhe a
   opção, e um valor inválido volta com o motivo, em vez de virar "sem prazo" em silêncio. *@

<fieldset class="mb-3">
    <legend class="form-label fs-6">@T["Validity"]</legend>

    <div class="form-check mb-1">
        <input class="form-check-input" type="radio" name="validade" value="sempre"
               id="validade-sempre-@Prefixo" checked />
        <label class="form-check-label" for="validade-sempre-@Prefixo">@T["No end date"]</label>
    </div>

    <div class="form-check mb-1 d-flex flex-wrap align-items-center gap-2">
        <input class="form-check-input mt-0" type="radio" name="validade" value="dias" id="validade-dias-@Prefixo" />
        <label class="form-check-label" for="validade-dias-@Prefixo">@T["For"]</label>
        <input class="form-control form-control-sm" style="width: 5.5rem" type="number" min="1" max="3650"
               name="dias" id="dias-@Prefixo" placeholder="30" aria-label="@T["Number of days"]"
               onfocus="document.getElementById('validade-dias-@Prefixo').checked = true" />
        <span class="small">@T["days from the first visit"]</span>
    </div>

    <div class="form-check d-flex flex-wrap align-items-center gap-2">
        <input class="form-check-input mt-0" type="radio" name="validade" value="ate" id="validade-ate-@Prefixo" />
        <label class="form-check-label" for="validade-ate-@Prefixo">@T["Until"]</label>
        <input class="form-control form-control-sm" style="width: 10rem" type="date"
               name="dataFinal" id="data-@Prefixo" aria-label="@T["End date"]"
               onfocus="document.getElementById('validade-ate-@Prefixo').checked = true" />
        <span class="small text-body-secondary">@T["(the whole day included)"]</span>
    </div>
</fieldset>

@code {
    /// <summary>Distingue os campos quando o formulário aparece mais de uma vez na página.</summary>
    [Parameter, EditorRequired]
    public string Prefixo { get; set; } = string.Empty;
}
