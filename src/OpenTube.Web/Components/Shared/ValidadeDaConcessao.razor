@* Escolha da validade, compartilhada pelos três formulários de concessão. *@

<fieldset class="mb-3">
    <legend class="form-label">@T["Validity"]</legend>

    <div class="form-check">
        <input class="form-check-input" type="radio" name="validade" value="sempre"
               id="validade-sempre-@Prefixo" checked />
        <label class="form-check-label" for="validade-sempre-@Prefixo">@T["No end date"]</label>
    </div>

    <div class="form-check">
        <input class="form-check-input" type="radio" name="validade" value="dias"
               id="validade-dias-@Prefixo" />
        <label class="form-check-label" for="validade-dias-@Prefixo">
            @T["For a period from the first visit"]
        </label>
    </div>

    <div class="form-check">
        <input class="form-check-input" type="radio" name="validade" value="ate"
               id="validade-ate-@Prefixo" />
        <label class="form-check-label" for="validade-ate-@Prefixo">@T["Until a date"]</label>
    </div>

    <div class="mt-2">
        <label class="form-label visually-hidden" for="valor-@Prefixo">
            @T["Number of days or end date"]
        </label>
        <input class="form-control" id="valor-@Prefixo" name="valorDaValidade"
               placeholder="30 (dias) ou 2026-12-31 (data)" />
        <div class="form-text">
            @T["Fill in according to the option. No end date leaves this field empty."]
        </div>
    </div>
</fieldset>

@code {
    /// <summary>Distingue os campos quando o formulário aparece mais de uma vez na página.</summary>
    [Parameter, EditorRequired]
    public string Prefixo { get; set; } = string.Empty;
}
