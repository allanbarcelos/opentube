@* Cartão de vídeo usado na home, na busca e na área administrativa. *@

<div class="col">
    <a class="card h-100 text-decoration-none text-body shadow-sm" href="/watch/@Video.Slug">
        @if (Video.Status == (int)VideoStatus.Ready)
        {
            <img class="card-img-top video-thumb" src="/api/videos/@Video.Id/thumbnail"
                 alt="@T.Format("Thumbnail of {0}", Video.Title)" loading="lazy" />
        }
        else
        {
            <div class="card-img-top video-thumb-placeholder">
                <span class="small">@EstadoTexto</span>
            </div>
        }

        <div class="card-body">
            <h2 class="h6 card-title video-card-title mb-1">@Video.Title</h2>
            <p class="card-text small text-body-secondary mb-0">
                @Video.DurationLabel
                @if (MostrarVisibilidade)
                {
                    <span class="badge @DistintivoClasse ms-2">@VisibilidadeTexto</span>
                }
            </p>
        </div>
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public VideoSummary Video { get; set; } = default!;

    /// <summary>Exibe o distintivo de visibilidade; usado apenas na área administrativa.</summary>
    [Parameter]
    public bool MostrarVisibilidade { get; set; }

    private string EstadoTexto => (VideoStatus)Video.Status switch
    {
        VideoStatus.Draft => T["Waiting for the upload"],
        VideoStatus.Uploaded => T["Queued"],
        VideoStatus.Processing => T["Processing"],
        VideoStatus.Failed => T["Failed"],
        _ => T["No thumbnail"]
    };

    private string VisibilidadeTexto => (VideoVisibility)Video.Visibility switch
    {
        VideoVisibility.Public => T["Public"],
        VideoVisibility.Restricted => T["Restricted"],
        _ => T["Private"]
    };

    private string DistintivoClasse => (VideoVisibility)Video.Visibility switch
    {
        VideoVisibility.Public => "text-bg-success",
        VideoVisibility.Restricted => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}
