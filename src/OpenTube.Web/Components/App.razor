@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="OpenTube (https://github.com/allanbarcelos/opentube)" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["OpenTube.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    @* Comportamentos do Bootstrap (menu recolhido no celular, abas, sanfonas). As delegações
       dele ficam no documento, então valem também nas páginas da navegação aprimorada. *@
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Carregados uma vez para todas as páginas: o player se monta sozinho na carga inicial e
       a cada navegação aprimorada, que não executaria scripts colocados na própria página.
       Pelo @Assets o endereço leva a impressão do conteúdo: o navegador não fica com uma
       versão antiga guardada depois de uma atualização. *@
    <script src="@Assets["js/marca-dagua.js"]"></script>
    <script src="@Assets["js/analytics.js"]"></script>
    <script src="@Assets["js/controles.js"]"></script>
    <script src="@Assets["js/player.js"]"></script>
    <script src="@Assets["js/legendas.js"]"></script>
    <script src="@Assets["js/editor-de-legendas.js"]"></script>
    <script src="@Assets["js/upload.js"]"></script>
    <script src="@Assets["js/sumario.js"]"></script>
    <script src="@Assets["js/avaliacao.js"]"></script>
    <script src="@Assets["js/copiar.js"]"></script>
</body>

</html>
